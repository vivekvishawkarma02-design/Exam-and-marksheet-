        data.status in ['NEW', 'CONTACTED', 'VISIT_PLANNED', 'ADMITTED', 'LOST'] &&
        data.lostReason is string && data.lostReason.size() <= 240 &&
        (data.status != 'LOST' || data.lostReason.size() >= 1) &&
        data.convertedStudentDocId is string && data.convertedStudentDocId.size() <= 128 &&
        data.convertedStudentAdmNo is string && data.convertedStudentAdmNo.size() <= 60 &&
        data.convertedAtMs is int && data.convertedAtMs >= 0 &&
        data.createdByUid is string && data.createdByUid.size() >= 1 && data.createdByUid.size() <= 128 &&
        data.createdByName is string && data.createdByName.size() >= 1 && data.createdByName.size() <= 120 &&
        data.createdAtMs is int && data.createdAtMs >= 0 &&
        data.updatedByUid == request.auth.uid &&
        data.updatedByName is string && data.updatedByName.size() >= 1 && data.updatedByName.size() <= 120 &&
        data.clientEditedAtMs is int && data.clientEditedAtMs >= 0 &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    // =========================================================================
    // PHASE 11 VALIDATORS: EXAMS & ADMIT CARDS, STOCK, TRANSPORT ROUTES
    // =========================================================================

    function isValidExamSchedule(data) {
      return data.keys().hasAll([
          'schoolId', 'session', 'examType', 'title', 'entries',
          'withholdAdmitCardAboveDuesRs', 'admitCardOverrideStudentIds', 'admitCardInstructions',
          'createdByUid', 'updatedByUid', 'updatedByName', 'clientEditedAtMs', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'schoolId', 'session', 'examType', 'title', 'entries',
          'withholdAdmitCardAboveDuesRs', 'admitCardOverrideStudentIds', 'admitCardInstructions',
          'createdByUid', 'updatedByUid', 'updatedByName', 'clientEditedAtMs', 'updatedAt'
        ]) &&
        isValidId(data.schoolId) &&
        data.session is string && data.session.size() >= 4 && data.session.size() <= 30 &&
        data.examType in ['UT_I', 'UT_II', 'HALF_YEARLY', 'YEARLY', 'CUSTOM'] &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.entries is list && data.entries.size() <= 300 &&
        data.withholdAdmitCardAboveDuesRs is int && data.withholdAdmitCardAboveDuesRs >= 0 && data.withholdAdmitCardAboveDuesRs <= 10000000 &&
        isValidStringList(data.admitCardOverrideStudentIds, 500) &&
        data.admitCardInstructions is string && data.admitCardInstructions.size() <= 500 &&
        data.createdByUid is string && data.createdByUid.size() >= 1 && data.createdByUid.size() <= 128 &&
        data.updatedByUid == request.auth.uid &&
        data.updatedByName is string && data.updatedByName.size() >= 1 && data.updatedByName.size() <= 120 &&
        data.clientEditedAtMs is int && data.clientEditedAtMs >= 0 &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidExamRoom(data) {
      return data.keys().hasAll(['schoolId', 'roomName', 'capacity', 'active', 'updatedByUid', 'clientEditedAtMs', 'updatedAt']) &&
        data.keys().hasOnly(['schoolId', 'roomName', 'capacity', 'active', 'updatedByUid', 'clientEditedAtMs', 'updatedAt']) &&
        isValidId(data.schoolId) &&
        data.roomName is string && data.roomName.size() >= 1 && data.roomName.size() <= 60 &&
        data.capacity is int && data.capacity >= 1 && data.capacity <= 500 &&
        data.active is bool &&
        data.updatedByUid == request.auth.uid &&
        data.clientEditedAtMs is int && data.clientEditedAtMs >= 0 &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidExamSeating(data) {
      return data.keys().hasAll([
          'schoolId', 'session', 'examId', 'allocationMode', 'includedClasses',
          'roomIds', 'allocations', 'unallocatedStudentIds', 'updatedByUid', 'clientEditedAtMs', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'schoolId', 'session', 'examId', 'allocationMode', 'includedClasses',
          'roomIds', 'allocations', 'unallocatedStudentIds', 'updatedByUid', 'clientEditedAtMs', 'updatedAt'
        ]) &&
        isValidId(data.schoolId) &&
        data.session is string && data.session.size() >= 4 && data.session.size() <= 30 &&
        isValidId(data.examId) &&
        data.allocationMode in ['BY_ROLL_NUMBER', 'MIXED_BY_CLASS'] &&
        isValidStringList(data.includedClasses, 60) &&
        isValidStringList(data.roomIds, 100) &&
        data.allocations is list && data.allocations.size() <= 2500 &&
        isValidStringList(data.unallocatedStudentIds, 1000) &&
        data.updatedByUid == request.auth.uid &&
        data.clientEditedAtMs is int && data.clientEditedAtMs >= 0 &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidExamInvigilatorDuty(data) {
      return data.keys().hasAll([
          'schoolId', 'session', 'examId', 'examTitle', 'dateIso', 'startTime', 'endTime',
          'roomId', 'roomName', 'teacherId', 'teacherUid', 'teacherName',
          'assignedManually', 'updatedByUid', 'clientEditedAtMs', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'schoolId', 'session', 'examId', 'examTitle', 'dateIso', 'startTime', 'endTime',
          'roomId', 'roomName', 'teacherId', 'teacherUid', 'teacherName',
          'assignedManually', 'updatedByUid', 'clientEditedAtMs', 'updatedAt'
        ]) &&
        isValidId(data.schoolId) &&
        data.session is string && data.session.size() >= 4 && data.session.size() <= 30 &&
        isValidId(data.examId) &&
        data.examTitle is string && data.examTitle.size() >= 1 && data.examTitle.size() <= 120 &&
        isValidIsoDate(data.dateIso) &&
        data.startTime is string && data.startTime.size() >= 4 && data.startTime.size() <= 8 &&
        data.endTime is string && data.endTime.size() >= 4 && data.endTime.size() <= 8 &&
        isValidId(data.roomId) &&
        data.roomName is string && data.roomName.size() >= 1 && data.roomName.size() <= 60 &&
        isValidId(data.teacherId) &&
        data.teacherUid is string && data.teacherUid.size() <= 128 &&
        data.teacherName is string && data.teacherName.size() >= 1 && data.teacherName.size() <= 120 &&
        data.assignedManually is bool &&
        data.updatedByUid == request.auth.uid &&
        data.clientEditedAtMs is int && data.clientEditedAtMs >= 0 &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidStockTransaction(data) {
      return data.keys().hasAll([
          'schoolId', 'session', 'itemId', 'itemName', 'txType', 'dateIso', 'quantityDelta',
          'unitCostRs', 'totalCostRs', 'supplier', 'reason',
          'createdByUid', 'createdByName', 'createdAtMs', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'schoolId', 'session', 'itemId', 'itemName', 'txType', 'dateIso', 'quantityDelta',
          'unitCostRs', 'totalCostRs', 'supplier', 'reason',
          'createdByUid', 'createdByName', 'createdAtMs', 'createdAt'
        ]) &&
        isValidId(data.schoolId) &&
        data.session is string && data.session.size() >= 4 && data.session.size() <= 30 &&
        data.itemId is string && data.itemId.size() >= 1 && data.itemId.size() <= 80 &&
        data.itemName is string && data.itemName.size() >= 1 && data.itemName.size() <= 100 &&
        data.txType in ['STOCK_IN', 'ADJUSTMENT'] &&
        isValidIsoDate(data.dateIso) &&
        data.quantityDelta is int && data.quantityDelta != 0 &&
        (data.txType != 'STOCK_IN' || data.quantityDelta > 0) &&
        data.unitCostRs is int && data.unitCostRs >= 0 && data.unitCostRs <= 1000000 &&
        data.totalCostRs is int && data.totalCostRs >= 0 && data.totalCostRs <= 100000000 &&
        data.supplier is string && data.supplier.size() <= 120 &&
        data.reason is string && data.reason.size() <= 300 &&
        (data.txType != 'ADJUSTMENT' || data.reason.size() >= 1) &&
        data.createdByUid == request.auth.uid &&
        data.createdByName is string && data.createdByName.size() >= 1 && data.createdByName.size() <= 120 &&
        data.createdAtMs is int && data.createdAtMs >= 0 &&
        isValidTimestamp(data.createdAt);
    }

    function isValidTransportRoute(data) {
      return data.keys().hasAll([
          'schoolId', 'routeName', 'vehicleNumber', 'vehicleType', 'seatCapacity',
          'driverName', 'driverPhone', 'monthlyFeeRs', 'stops', 'active',
          'updatedByUid', 'updatedByName', 'clientEditedAtMs', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'schoolId', 'routeName', 'vehicleNumber', 'vehicleType', 'seatCapacity',
          'driverName', 'driverPhone', 'monthlyFeeRs', 'stops', 'active',
          'updatedByUid', 'updatedByName', 'clientEditedAtMs', 'updatedAt'
        ]) &&
        isValidId(data.schoolId) &&
        data.routeName is string && data.routeName.size() >= 1 && data.routeName.size() <= 80 &&
        data.vehicleNumber is string && data.vehicleNumber.size() <= 40 &&
        data.vehicleType is string && data.vehicleType.size() >= 1 && data.vehicleType.size() <= 24 &&
        data.seatCapacity is int && data.seatCapacity >= 1 && data.seatCapacity <= 200 &&
        data.driverName is string && data.driverName.size() <= 100 &&
        data.driverPhone is string && data.driverPhone.size() <= 24 &&
        data.monthlyFeeRs is int && data.monthlyFeeRs >= 0 && data.monthlyFeeRs <= 500000 &&
        data.stops is list && data.stops.size() <= 60 &&
        data.active is bool &&
        data.updatedByUid == request.auth.uid &&
        data.updatedByName is string && data.updatedByName.size() >= 1 && data.updatedByName.size() <= 120 &&
        data.clientEditedAtMs is int && data.clientEditedAtMs >= 0 &&
        isValidTimestamp(data.updatedAt);
    }

    // =========================================================================
    // 1. PRIVATE USER ACCOUNT & MEMBERSHIPS INDEX
    // =========================================================================
    match /users/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create: if isSignedIn() &&
        request.auth.uid == uid &&
        isValidUserAccount(incoming(), uid);
      allow update: if isSignedIn() &&
        request.auth.uid == uid &&
        isValidUserAccount(incoming(), uid) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'email', 'memberships', 'pendingRequests', 'updatedAt']);
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // =========================================================================
    // 2. ORG CODE RESERVATION (Exact-lookup ONLY by code; NEVER listable)
    // =========================================================================
    match /orgCodes/{code} {
      allow get: if isSignedIn() && isValidOrgCode(code);
      allow list: if false;

      allow create: if isSignedIn() &&
        isValidOrgCode(code) &&
        isValidOrgCodeReservation(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        existsAfter(orgPath(incoming().orgId)) &&
        getAfter(orgPath(incoming().orgId)).data.ownerUid == request.auth.uid &&
        getAfter(orgPath(incoming().orgId)).data.code == code;

      allow update: if isSignedIn() &&
        isValidOrgCode(code) &&
        isValidOrgCodeReservation(incoming()) &&
        existing().ownerUid == request.auth.uid &&
        incoming().orgId == existing().orgId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'ownerUid']);

      allow delete: if isSignedIn() &&
        isValidOrgCode(code) &&
        existing().ownerUid == request.auth.uid;
    }

    // =========================================================================
    // 3. ORGANISATIONS & MULTI-TENANT SUBCOLLECTIONS
    // =========================================================================
    match /organisations/{orgId} {
      allow get: if isSignedIn() && isValidId(orgId) && isActiveMember(orgId);
      allow list: if false;

      // Atomic creation: reserves orgCode and creates OWNER member in the same transaction
      allow create: if isSignedIn() &&
        isValidId(orgId) &&
        isValidOrganisation(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        existsAfter(/databases/$(database)/documents/orgCodes/$(incoming().code)) &&
        existsAfter(memberPath(orgId, request.auth.uid)) &&
        getAfter(memberPath(orgId, request.auth.uid)).data.role == 'OWNER' &&
        getAfter(memberPath(orgId, request.auth.uid)).data.status == 'active';

      allow update: if isSignedIn() &&
        isValidId(orgId) &&
        isValidOrganisation(incoming()) &&
        incoming().code == existing().code &&
        incoming().createdAt == existing().createdAt && (
          // Action 1: Admin or settings-editor updating org profile or global settings
          (
            (isOrgAdmin(orgId) || hasModuleEdit(orgId, 'settings')) &&
            incoming().ownerUid == existing().ownerUid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'contactMobile', 'contactEmail', 'settings', 'updatedAt'])
          ) ||
          // Action 2: Owner transferring ownership to an existing active member
          (
            existing().ownerUid == request.auth.uid &&
            isOrgOwner(orgId) &&
            exists(memberPath(orgId, incoming().ownerUid)) &&
            get(memberPath(orgId, incoming().ownerUid)).data.status == 'active' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['ownerUid', 'updatedAt'])
          )
        );

      // Only the Owner may delete the organisation
      allow delete: if isSignedIn() &&
        isValidId(orgId) &&
        existing().ownerUid == request.auth.uid &&
        isOrgOwner(orgId);

      // -----------------------------------------------------------------------
      // 3a. MEMBERS
      // -----------------------------------------------------------------------
      match /members/{memberUid} {
        allow get: if isSignedIn() && isValidId(memberUid) && (
          request.auth.uid == memberUid ||
          isOrgAdmin(orgId) ||
          hasModuleView(orgId, 'members')
        );
        allow list: if isSignedIn() && (
          isOrgAdmin(orgId) ||
          hasModuleView(orgId, 'members')
        );

        allow create: if isSignedIn() &&
          isValidId(memberUid) &&
          isValidMember(incoming(), memberUid) && (
            // Action 1: Org creation bootstrap (Owner creates their own OWNER record atomically)
            (
              request.auth.uid == memberUid &&
              incoming().role == 'OWNER' &&
              incoming().status == 'active' &&
              incoming().allSchools == true &&
              existsAfter(orgPath(orgId)) &&
              getAfter(orgPath(orgId)).data.ownerUid == request.auth.uid
            ) ||
            // Action 2: Admin or Members-editor approving a join request / adding a non-owner member
            (
              (isOrgAdmin(orgId) || hasModuleEdit(orgId, 'members')) &&
              incoming().role != 'OWNER' &&
              incoming().status == 'active'
            ) ||
            // Action 3: One-time invite code redemption in an atomic transaction
            (
              request.auth.uid == memberUid &&
              incoming().role != 'OWNER' &&
              incoming().status == 'active' &&
              'inviteCodeUsed' in incoming() &&
              isValidId(incoming().inviteCodeUsed) &&
              exists(/databases/$(database)/documents/organisations/$(orgId)/inviteCodes/$(incoming().inviteCodeUsed)) &&
              get(/databases/$(database)/documents/organisations/$(orgId)/inviteCodes/$(incoming().inviteCodeUsed)).data.usedByUid == '' &&
              get(/databases/$(database)/documents/organisations/$(orgId)/inviteCodes/$(incoming().inviteCodeUsed)).data.expiresAt > request.time &&
              getAfter(/databases/$(database)/documents/organisations/$(orgId)/inviteCodes/$(incoming().inviteCodeUsed)).data.usedByUid == request.auth.uid &&
              incoming().role == get(/databases/$(database)/documents/organisations/$(orgId)/inviteCodes/$(incoming().inviteCodeUsed)).data.presetRole &&
              incoming().allSchools == get(/databases/$(database)/documents/organisations/$(orgId)/inviteCodes/$(incoming().inviteCodeUsed)).data.allSchools &&
              incoming().schools == get(/databases/$(database)/documents/organisations/$(orgId)/inviteCodes/$(incoming().inviteCodeUsed)).data.schools &&
              incoming().permissions == get(/databases/$(database)/documents/organisations/$(orgId)/inviteCodes/$(incoming().inviteCodeUsed)).data.permissions
            )
          );

        allow update: if isSignedIn() &&
          isValidId(memberUid) &&
          isValidMember(incoming(), memberUid) &&
          incoming().uid == existing().uid &&
          incoming().createdAt == existing().createdAt &&
          canUpdateMember(orgId, memberUid);

        allow delete: if isSignedIn() && isValidId(memberUid) && (
          // Owner can never be removed individually; only deleted when the entire organisation is deleted by Owner
          (existing().role == 'OWNER' && isOrgOwner(orgId) && !existsAfter(orgPath(orgId))) ||
          // Any non-owner member can leave the organisation
          (request.auth.uid == memberUid && existing().role != 'OWNER') ||
          // Admin or Owner can remove a non-owner member
          (isOrgAdmin(orgId) && existing().role != 'OWNER')
        );
      }

      // -----------------------------------------------------------------------
      // 3b. JOIN REQUESTS
      // -----------------------------------------------------------------------
      match /joinRequests/{reqUid} {
        allow get: if isSignedIn() && isValidId(reqUid) && (
          request.auth.uid == reqUid ||
          isOrgAdmin(orgId) ||
          hasModuleView(orgId, 'members')
        );
        allow list: if isSignedIn() && (
          isOrgAdmin(orgId) ||
          hasModuleView(orgId, 'members')
        );

        allow create: if isSignedIn() &&
          isValidId(reqUid) &&
          request.auth.uid == reqUid &&
          isValidJoinRequest(incoming(), reqUid) &&
          incoming().status == 'pending' &&
          exists(orgPath(orgId));

        allow update: if isSignedIn() &&
          isValidId(reqUid) &&
          isValidJoinRequest(incoming(), reqUid) &&
          incoming().uid == existing().uid &&
          incoming().createdAt == existing().createdAt && (
            // Action 1: Admin or Members-editor approving/rejecting a pending request
            (
              (isOrgAdmin(orgId) || hasModuleEdit(orgId, 'members')) &&
              existing().status == 'pending' &&
              incoming().status in ['approved', 'rejected'] &&
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reviewedByUid', 'updatedAt'])
            ) ||
            // Action 2: Requester updating or resubmitting a pending/rejected request
            (
              request.auth.uid == reqUid &&
              existing().status in ['pending', 'rejected'] &&
              incoming().status == 'pending' &&
              incoming().diff(existing()).affectedKeys().hasOnly(['name', 'message', 'requestedRole', 'status', 'updatedAt'])
            )
          );

        allow delete: if isSignedIn() && isValidId(reqUid) && (
          request.auth.uid == reqUid ||
          isOrgAdmin(orgId) ||
          hasModuleEdit(orgId, 'members')
        );
      }

      // -----------------------------------------------------------------------
      // 3c. ONE-TIME INVITE CODES
      // -----------------------------------------------------------------------
      match /inviteCodes/{inviteCode} {
        allow get: if isSignedIn() && isValidId(inviteCode);
        allow list: if isSignedIn() && (
          isOrgAdmin(orgId) ||
          hasModuleView(orgId, 'members')
        );

        allow create: if isSignedIn() &&
          isValidId(inviteCode) &&
          isValidInviteCode(incoming(), orgId, inviteCode) &&
          isOrgAdmin(orgId) &&
          incoming().createdByUid == request.auth.uid &&
          incoming().usedByUid == '' &&
          incoming().expiresAt > request.time;

        allow update: if isSignedIn() &&
          isValidId(inviteCode) &&
          isValidInviteCode(incoming(), orgId, inviteCode) &&
          existing().usedByUid == '' &&
          existing().expiresAt > request.time &&
          incoming().usedByUid == request.auth.uid &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['usedByUid', 'usedAt']) &&
          existsAfter(memberPath(orgId, request.auth.uid));

        allow delete: if isSignedIn() && isValidId(inviteCode) && isOrgAdmin(orgId);
      }

      // -----------------------------------------------------------------------
      // 3d. AUDIT LOG (Append-only by members, readable ONLY by Admins)
      // -----------------------------------------------------------------------
      match /auditLog/{entryId} {
        allow get, list: if isSignedIn() && isOrgAdmin(orgId);
        allow create: if isSignedIn() &&
          isValidId(entryId) &&
          isValidAuditEntry(incoming()) && (
            isActiveMember(orgId) ||
            (existsAfter(orgPath(orgId)) && getAfter(orgPath(orgId)).data.ownerUid == request.auth.uid)
          );
        allow update: if false;
        allow delete: if isSignedIn() && isOrgOwner(orgId) && !existsAfter(orgPath(orgId));
      }

      // -----------------------------------------------------------------------
      // 3e. SCHOOLS & SCHOOL-SCOPED ACADEMIC DATA
      // -----------------------------------------------------------------------
      match /schools/{schoolId} {
        allow get: if isSignedIn() && isValidId(schoolId) && canAccessSchool(orgId, schoolId);
        allow list: if isSignedIn() && (
          isOrgAdmin(orgId) ||
          (isActiveMember(orgId) && memberData(orgId).allSchools == true)
        );

        allow create: if isSignedIn() &&
          isValidId(schoolId) &&
          isValidSchool(incoming(), schoolId) && (
            // Bootstrap first school atomically with organisation creation
            (existsAfter(orgPath(orgId)) && getAfter(orgPath(orgId)).data.ownerUid == request.auth.uid) ||
            isOrgAdmin(orgId) ||
            hasModuleEdit(orgId, 'settings')
          );

        allow update: if isSignedIn() &&
          isValidId(schoolId) &&
          isValidSchool(incoming(), schoolId) &&
          incoming().schoolKey == existing().schoolKey &&
          incoming().createdAt == existing().createdAt &&
          canAccessSchool(orgId, schoolId) && (
            (
              (isOrgAdmin(orgId) || hasModuleEdit(orgId, 'settings')) &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'name', 'address', 'mobile', 'email', 'logoBase64',
                'active', 'classGroups', 'classes',
                'printClassTeacherNameOnReports', 'checkReportCardsReadyBeforeBatch',
                'openExamsForTeachers', 'classTeacherNamesBySection',
                'autoFillReportAttendance', 'classTeacherAttendanceEditDaysBack',
                'updatedAt'
              ])
            ) || (
              hasModuleEdit(orgId, 'teachers') &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'classTeacherNamesBySection', 'updatedAt'
              ])
            )
          );

        allow delete: if isSignedIn() && isValidId(schoolId) && isOrgAdmin(orgId);

        // --- STUDENTS (Controlled by 'students' OR 'studentRegister'; readable by 'fees', 'certificates', 'enquiry'; create also by 'enquiry'; mark-left update also by 'certificates') ---
        match /students/{studentId} {
          allow get, list: if isSignedIn() &&
            canAccessSchool(orgId, schoolId) && (
              hasModuleView(orgId, 'students') ||
              hasModuleView(orgId, 'studentRegister') ||
              hasModuleView(orgId, 'fees') ||
              hasModuleView(orgId, 'certificates') ||
              hasModuleView(orgId, 'enquiry') ||
              hasModuleView(orgId, 'exams') ||
              hasModuleView(orgId, 'transport') ||
              hasModuleView(orgId, 'marks') ||
              hasModuleView(orgId, 'coScholastic') ||
              hasModuleView(orgId, 'reports') ||
              hasModuleView(orgId, 'attendance') ||
              hasAnyClassTeacherSection(orgId)
            );

          allow create: if isSignedIn() &&
            isValidId(studentId) &&
            isValidStudent(incoming(), schoolId) &&
            canAccessSchool(orgId, schoolId) && (
              hasModuleEdit(orgId, 'students') ||
              hasModuleEdit(orgId, 'studentRegister') ||
              hasModuleEdit(orgId, 'enquiry')
            );

          allow update: if isSignedIn() &&
            isValidId(studentId) &&
            isValidStudent(incoming(), schoolId) &&
            incoming().schoolId == existing().schoolId &&
            incoming().createdAt == existing().createdAt &&
            canUpdateStudent(orgId, schoolId);

          allow delete: if isSignedIn() &&
            isValidId(studentId) &&
            canAccessSchool(orgId, schoolId) && (
              hasModuleEdit(orgId, 'students') ||
              hasModuleEdit(orgId, 'studentRegister')
            );
        }

        // --- MARKS ---
        match /marks/{markId} {
          allow get, list: if isSignedIn() &&
            canAccessSchool(orgId, schoolId) && (
              hasModuleView(orgId, 'marks') ||
              hasModuleView(orgId, 'reports')
            );

          allow create: if isSignedIn() &&
            isValidId(markId) &&
            isValidMark(incoming(), schoolId) &&
            canEditMarkScope(orgId, schoolId, incoming().studentId, incoming().className, incoming().subjectName, incoming().componentKey);

          allow update: if isSignedIn() &&
            isValidId(markId) &&
            isValidMark(incoming(), schoolId) &&
            incoming().studentId == existing().studentId &&
            incoming().schoolId == existing().schoolId &&
            incoming().subjectName == existing().subjectName &&
            incoming().componentKey == existing().componentKey &&
            incoming().createdAt == existing().createdAt &&
            canEditMarkScope(orgId, schoolId, incoming().studentId, incoming().className, incoming().subjectName, incoming().componentKey) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'className', 'rawValue', 'updatedByUid', 'updatedByName', 'clientEditedAtMs', 'updatedAt'
            ]);

          allow delete: if isSignedIn() &&
            isValidId(markId) &&
            canEditMarkScope(orgId, schoolId, existing().studentId, existing().className, existing().subjectName, existing().componentKey);
        }

        // --- MARK EDIT LOGS (Phase 3: Append-only marks change history) ---
        match /markEditLogs/{logId} {
          allow get, list: if isSignedIn() &&
            canAccessSchool(orgId, schoolId) && (
              isOrgAdmin(orgId) ||
              hasModuleView(orgId, 'marks')
            );

          allow create: if isSignedIn() &&
            isValidId(logId) &&
            isValidMarkEditLog(incoming(), schoolId) &&
            canEditMarkScope(orgId, schoolId, incoming().studentId, incoming().className, incoming().subjectName, incoming().componentKey);

          allow update: if false;
          allow delete: if false;
        }

        // --- CO-SCHOLASTIC ---
        match /coScholastic/{coId} {
          allow get, list: if isSignedIn() &&
            canAccessSchool(orgId, schoolId) && (
              hasModuleView(orgId, 'coScholastic') ||
              hasModuleView(orgId, 'reports')
            );

          allow create: if isSignedIn() &&
            isValidId(coId) &&
            isValidCoScholastic(incoming(), schoolId) &&
            canEditCoScholasticScope(orgId, schoolId, incoming().studentId);

          allow update: if isSignedIn() &&
            isValidId(coId) &&
            isValidCoScholastic(incoming(), schoolId) &&
            incoming().studentId == existing().studentId &&
            incoming().schoolId == existing().schoolId &&
            incoming().termNo == existing().termNo &&
            incoming().areaCode == existing().areaCode &&
            incoming().createdAt == existing().createdAt &&
            canEditCoScholasticScope(orgId, schoolId, incoming().studentId) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'grade', 'updatedByUid', 'updatedAt'
            ]);

          allow delete: if isSignedIn() &&
            isValidId(coId) &&
            canEditCoScholasticScope(orgId, schoolId, existing().studentId);
        }

        // --- TERM INFO (ATTENDANCE & REMARKS) ---
        match /termInfo/{termInfoId} {
          allow get, list: if isSignedIn() &&
            canAccessSchool(orgId, schoolId) && (
              hasModuleView(orgId, 'coScholastic') ||
              hasModuleView(orgId, 'reports') ||
              hasModuleView(orgId, 'attendance') ||
              hasAnyClassTeacherSection(orgId)
            );

          allow create: if isSignedIn() &&
            isValidId(termInfoId) &&
            isValidTermInfo(incoming(), schoolId) && (
              canEditCoScholasticScope(orgId, schoolId, incoming().studentId) ||
              (
                canRecalculateTermAttendance(orgId, schoolId, incoming().studentId) &&
                incoming().remarks == '' &&
                incoming().promotedTo == '' &&
                incoming().reportDate == ''
              )
            );

          allow update: if isSignedIn() &&
            isValidId(termInfoId) &&
            isValidTermInfo(incoming(), schoolId) &&
            incoming().studentId == existing().studentId &&
            incoming().schoolId == existing().schoolId &&
            incoming().termNo == existing().termNo &&
            incoming().createdAt == existing().createdAt && (
              (
                canEditCoScholasticScope(orgId, schoolId, incoming().studentId) &&
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'daysPresent', 'workingDays', 'remarks', 'promotedTo',
                  'reportDate', 'attendanceManualOverride', 'updatedByUid', 'updatedAt'
                ])
              ) || (
                canRecalculateTermAttendance(orgId, schoolId, incoming().studentId) &&
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'daysPresent', 'workingDays', 'attendanceManualOverride', 'updatedByUid', 'updatedAt'
                ])
              )
            );

          allow delete: if isSignedIn() &&
            isValidId(termInfoId) &&
            canEditCoScholasticScope(orgId, schoolId, existing().studentId);
        }
      }

      // -----------------------------------------------------------------------
      // 3f. PHASE 4: TEACHERS, PERIOD STRUCTURE, ASSIGNMENTS & SUBJECT RULES
      // Controlled strictly by the 'teachers' ("Teachers and assignments") module
      // -----------------------------------------------------------------------
      match /teachers/{teacherId} {
        allow get, list: if isSignedIn() && (
          hasModuleView(orgId, 'teachers') ||
          hasModuleEdit(orgId, 'timetable') ||
          hasModuleView(orgId, 'exams') ||
          ((hasModuleView(orgId, 'timetable') || hasModuleView(orgId, 'marks')) && resource.data.linkedMemberUid == request.auth.uid)
        );

        allow create: if isSignedIn() &&
          isValidId(teacherId) &&
          isValidTeacher(incoming()) && (
            hasModuleEdit(orgId, 'teachers') ||
            // Approved teacher self-syncing their own Phase 2 onboarding profile (no read granted)
            (
              isActiveMember(orgId) &&
              memberData(orgId).role == 'TEACHER' &&
              teacherId == ('tchr_member_' + request.auth.uid) &&
              incoming().linkedMemberUid == request.auth.uid
            )
          );

        allow update: if isSignedIn() &&
          isValidId(teacherId) &&
          isValidTeacher(incoming()) &&
          incoming().createdAt == existing().createdAt && (
            hasModuleEdit(orgId, 'teachers') ||
            (
              isActiveMember(orgId) &&
              memberData(orgId).role == 'TEACHER' &&
              teacherId == ('tchr_member_' + request.auth.uid) &&
              existing().linkedMemberUid == request.auth.uid &&
              incoming().linkedMemberUid == request.auth.uid &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'name', 'mobile', 'photoBase64', 'subjects', 'updatedAt'
              ])
            )
          );

        allow delete: if isSignedIn() &&
          isValidId(teacherId) &&
          hasModuleEdit(orgId, 'teachers');
      }

      match /periodStructures/{schoolId} {
        allow get, list: if isSignedIn() && (hasModuleView(orgId, 'teachers') || hasModuleEdit(orgId, 'timetable'));

        allow create: if isSignedIn() &&
          isValidId(schoolId) &&
          isValidPeriodStructure(incoming(), schoolId) &&
          hasModuleEdit(orgId, 'teachers') &&
          canAccessSchool(orgId, schoolId);

        allow update: if isSignedIn() &&
          isValidId(schoolId) &&
          isValidPeriodStructure(incoming(), schoolId) &&
          incoming().schoolId == existing().schoolId &&
          incoming().createdAt == existing().createdAt &&
          hasModuleEdit(orgId, 'teachers') &&
          canAccessSchool(orgId, schoolId);

        allow delete: if isSignedIn() &&
          isValidId(schoolId) &&
          hasModuleEdit(orgId, 'teachers') &&
          canAccessSchool(orgId, schoolId);
      }

      match /classAssignments/{assignmentId} {
        allow get, list: if isSignedIn() && (hasModuleView(orgId, 'teachers') || hasModuleEdit(orgId, 'timetable'));

        allow create: if isSignedIn() &&
          isValidId(assignmentId) &&
          isValidClassAssignment(incoming()) &&
          hasModuleEdit(orgId, 'teachers') &&
          canAccessSchool(orgId, incoming().schoolId);

        allow update: if isSignedIn() &&
          isValidId(assignmentId) &&
          isValidClassAssignment(incoming()) &&
          incoming().schoolId == existing().schoolId &&
          incoming().createdAt == existing().createdAt &&
          hasModuleEdit(orgId, 'teachers') &&
          canAccessSchool(orgId, incoming().schoolId);

        allow delete: if isSignedIn() &&
          isValidId(assignmentId) &&
          hasModuleEdit(orgId, 'teachers') &&
          canAccessSchool(orgId, existing().schoolId);
      }

      match /subjectRules/{ruleId} {
        allow get, list: if isSignedIn() && (hasModuleView(orgId, 'teachers') || hasModuleEdit(orgId, 'timetable'));

        allow create: if isSignedIn() &&
          isValidId(ruleId) &&
          isValidSubjectRule(incoming()) &&
          hasModuleEdit(orgId, 'teachers') &&
          canAccessSchool(orgId, incoming().schoolId);

        allow update: if isSignedIn() &&
          isValidId(ruleId) &&
          isValidSubjectRule(incoming()) &&
          incoming().schoolId == existing().schoolId &&
          incoming().subjectName == existing().subjectName &&
          incoming().createdAt == existing().createdAt &&
          hasModuleEdit(orgId, 'teachers') &&
          canAccessSchool(orgId, incoming().schoolId);

        allow delete: if isSignedIn() &&
          isValidId(ruleId) &&
          hasModuleEdit(orgId, 'teachers') &&
          canAccessSchool(orgId, existing().schoolId);
      }

      // -----------------------------------------------------------------------
      // 3g. PHASE 5: TIMETABLE CELLS & LAYOUT MIRROR
      // Controlled strictly by the 'timetable' ("Timetable") module
      // -----------------------------------------------------------------------
      match /timetableCells/{cellId} {
        allow get, list: if isSignedIn() && hasModuleView(orgId, 'timetable');

        allow create: if isSignedIn() &&
          isValidId(cellId) &&
          isValidTimetableCell(incoming()) &&
          hasModuleEdit(orgId, 'timetable') &&
          canAccessSchool(orgId, incoming().schoolId);

        allow update: if isSignedIn() &&
          isValidId(cellId) &&
          isValidTimetableCell(incoming()) &&
          incoming().schoolId == existing().schoolId &&
          incoming().session == existing().session &&
          incoming().className == existing().className &&
          incoming().section == existing().section &&
          incoming().day == existing().day &&
          incoming().slotId == existing().slotId &&
          incoming().createdAt == existing().createdAt &&
          hasModuleEdit(orgId, 'timetable') &&
          canAccessSchool(orgId, incoming().schoolId);

        allow delete: if isSignedIn() &&
          isValidId(cellId) &&
          hasModuleEdit(orgId, 'timetable') &&
          canAccessSchool(orgId, existing().schoolId);
      }

      match /timetableLayouts/{schoolId} {
        allow get, list: if isSignedIn() && hasModuleView(orgId, 'timetable');

        allow create: if isSignedIn() &&
          isValidId(schoolId) &&
          isValidPeriodStructure(incoming(), schoolId) &&
          (hasModuleEdit(orgId, 'teachers') || hasModuleEdit(orgId, 'timetable')) &&
          canAccessSchool(orgId, schoolId);

        allow update: if isSignedIn() &&
          isValidId(schoolId) &&
          isValidPeriodStructure(incoming(), schoolId) &&
          incoming().schoolId == existing().schoolId &&
          incoming().createdAt == existing().createdAt &&
          (hasModuleEdit(orgId, 'teachers') || hasModuleEdit(orgId, 'timetable')) &&
          canAccessSchool(orgId, schoolId);

        allow delete: if isSignedIn() &&
          isValidId(schoolId) &&
          (hasModuleEdit(orgId, 'teachers') || hasModuleEdit(orgId, 'timetable')) &&
          canAccessSchool(orgId, schoolId);
      }

      // -----------------------------------------------------------------------
      // 3h. PHASE 6: TEACHER LEAVES, SUBSTITUTIONS & AUTO-GENERATE UNDO SNAPSHOTS
      // Controlled by the 'timetable' ("Timetable") module; teachers linked to a
      // teacher profile with Timetable view access may request/cancel their own
      // PENDING leave, while approval/rejection and substitutions require Timetable edit.
      // -----------------------------------------------------------------------
      match /teacherLeaves/{leaveId} {
        allow get, list: if isSignedIn() && (
          hasModuleView(orgId, 'timetable') ||
          hasModuleView(orgId, 'exams')
        );

        allow create: if isSignedIn() &&
          isValidId(leaveId) &&
          isValidTeacherLeave(incoming()) && (
            hasModuleEdit(orgId, 'timetable') ||
            (
              hasModuleView(orgId, 'timetable') &&
              incoming().status == 'PENDING' &&
              incoming().requestedByUid == request.auth.uid &&
              incoming().approvedByUid == '' &&
              incoming().approvedAtMs == 0 &&
              exists(/databases/$(database)/documents/organisations/$(orgId)/teachers/$(incoming().teacherId)) &&
              get(/databases/$(database)/documents/organisations/$(orgId)/teachers/$(incoming().teacherId)).data.linkedMemberUid == request.auth.uid
            )
          );

        allow update: if isSignedIn() &&
          isValidId(leaveId) &&
          isValidTeacherLeave(incoming()) &&
          incoming().teacherId == existing().teacherId &&
          incoming().requestedByUid == existing().requestedByUid &&
          incoming().createdAt == existing().createdAt && (
            hasModuleEdit(orgId, 'timetable') ||
            (
              hasModuleView(orgId, 'timetable') &&
              existing().requestedByUid == request.auth.uid &&
              existing().status == 'PENDING' &&
              incoming().status in ['PENDING', 'CANCELLED'] &&
              incoming().approvedByUid == '' &&
              incoming().approvedAtMs == 0
            )
          );

        allow delete: if isSignedIn() &&
          isValidId(leaveId) &&
          hasModuleEdit(orgId, 'timetable');
      }

      match /substitutions/{subId} {
        allow get, list: if isSignedIn() && hasModuleView(orgId, 'timetable');

        allow create: if isSignedIn() &&
          isValidId(subId) &&
          isValidSubstitution(incoming()) &&
          hasModuleEdit(orgId, 'timetable') &&
          canAccessSchool(orgId, incoming().schoolId);

        allow update: if isSignedIn() &&
          isValidId(subId) &&
          isValidSubstitution(incoming()) &&
          incoming().date == existing().date &&
          incoming().schoolId == existing().schoolId &&
          incoming().session == existing().session &&
          incoming().className == existing().className &&
          incoming().section == existing().section &&
          incoming().slotId == existing().slotId &&
          incoming().createdAt == existing().createdAt &&
          hasModuleEdit(orgId, 'timetable') &&
          canAccessSchool(orgId, incoming().schoolId);

        allow delete: if isSignedIn() &&
          isValidId(subId) &&
          hasModuleEdit(orgId, 'timetable') &&
          canAccessSchool(orgId, existing().schoolId);
      }

      match /timetableUndoSnapshots/{snapId} {
        allow get, list: if isSignedIn() && hasModuleEdit(orgId, 'timetable');

        allow create, update: if isSignedIn() &&
          isValidId(snapId) &&
          isValidTimetableUndoSnapshot(incoming()) &&
          hasModuleEdit(orgId, 'timetable') &&
          canAccessSchool(orgId, incoming().schoolId);

        allow delete: if isSignedIn() &&
          isValidId(snapId) &&
          hasModuleEdit(orgId, 'timetable') &&
          canAccessSchool(orgId, existing().schoolId);
      }

      // -----------------------------------------------------------------------
      // 3i. PHASE 7: SERVER-VERIFIED TEACHER ACCESS SCOPES & TEACHER ATTENDANCE
      // -----------------------------------------------------------------------
      match /teacherScopes/{memberUid} {
        allow get: if isSignedIn() && isValidId(memberUid) && (
          request.auth.uid == memberUid ||
          isOrgAdmin(orgId) ||
          hasModuleView(orgId, 'teachers') ||
          (isActiveMember(orgId) && memberData(orgId).role != 'TEACHER' && (hasModuleView(orgId, 'marks') || hasModuleView(orgId, 'reports')))
        );
        allow list: if isSignedIn() && (
          isOrgAdmin(orgId) ||
          hasModuleView(orgId, 'teachers') ||
          (isActiveMember(orgId) && memberData(orgId).role != 'TEACHER' && (hasModuleView(orgId, 'marks') || hasModuleView(orgId, 'reports')))
        );

        allow create, update: if isSignedIn() &&
          isValidId(memberUid) &&
          isValidTeacherScope(incoming(), memberUid) && (
            isOrgAdmin(orgId) ||
            hasModuleEdit(orgId, 'teachers') ||
            hasModuleEdit(orgId, 'members')
          );

        allow delete: if isSignedIn() &&
          isValidId(memberUid) && (
            isOrgAdmin(orgId) ||
            hasModuleEdit(orgId, 'teachers') ||
            hasModuleEdit(orgId, 'members')
          );
      }

      match /teacherAttendance/{attId} {
        allow get, list: if isSignedIn() && hasModuleView(orgId, 'timetable');

        allow create: if isSignedIn() &&
          isValidId(attId) &&
          isValidTeacherAttendance(incoming()) &&
          hasModuleEdit(orgId, 'timetable') &&
          canAccessSchool(orgId, incoming().schoolId);

        allow update: if isSignedIn() &&
          isValidId(attId) &&
          isValidTeacherAttendance(incoming()) &&
          incoming().date == existing().date &&
          incoming().schoolId == existing().schoolId &&
          incoming().teacherId == existing().teacherId &&
          incoming().createdAt == existing().createdAt &&
          hasModuleEdit(orgId, 'timetable') &&
          canAccessSchool(orgId, incoming().schoolId);

        allow delete: if isSignedIn() &&
          isValidId(attId) &&
          hasModuleEdit(orgId, 'timetable') &&
          canAccessSchool(orgId, existing().schoolId);
      }

      // -----------------------------------------------------------------------
      // 3j. PHASE 8: SCHOOL CALENDAR & STUDENT ATTENDANCE (9th module + CT scope)
      // Strictly separate from Phase 7 Teacher Attendance.
      // -----------------------------------------------------------------------
      match /schoolCalendars/{calId} {
        allow get, list: if isSignedIn() && isActiveMember(orgId) && (
          hasModuleView(orgId, 'attendance') ||
          hasModuleView(orgId, 'reports') ||
          hasModuleView(orgId, 'coScholastic') ||
          hasModuleView(orgId, 'settings') ||
          hasAnyClassTeacherSection(orgId)
        );

        allow create: if isSignedIn() &&
          isValidId(calId) &&
          isValidSchoolCalendar(incoming()) &&
          canEditSchoolCalendar(orgId, incoming().schoolId);

        allow update: if isSignedIn() &&
          isValidId(calId) &&
          isValidSchoolCalendar(incoming()) &&
          incoming().schoolId == existing().schoolId &&
          incoming().session == existing().session &&
          incoming().createdAt == existing().createdAt &&
          canEditSchoolCalendar(orgId, incoming().schoolId);

        allow delete: if isSignedIn() &&
          isValidId(calId) &&
          isOrgAdmin(orgId);
      }

      match /studentAttendance/{attId} {
        allow get: if isSignedIn() && isActiveMember(orgId) &&
          canAccessSchool(orgId, resource.data.schoolId) && (
            hasModuleView(orgId, 'attendance') ||
            hasModuleView(orgId, 'reports') ||
            hasModuleView(orgId, 'coScholastic') ||
            isClassTeacherOfSection(orgId, resource.data.schoolId, resource.data.className, resource.data.section)
          );

        allow list: if isSignedIn() && isActiveMember(orgId) && (
          hasModuleView(orgId, 'attendance') ||
          (
            canAccessSchool(orgId, resource.data.schoolId) &&
            isClassTeacherOfSection(orgId, resource.data.schoolId, resource.data.className, resource.data.section)
          )
        );

        allow create: if isSignedIn() &&
          isValidId(attId) &&
          isValidStudentAttendance(incoming()) &&
          canEditStudentAttendance(orgId, incoming().schoolId, incoming().className, incoming().section, incoming().dateEpochDay);

        allow update: if isSignedIn() &&
          isValidId(attId) &&
          isValidStudentAttendance(incoming()) &&
          incoming().schoolId == existing().schoolId &&
          incoming().session == existing().session &&
          incoming().className == existing().className &&
          incoming().section == existing().section &&
          incoming().date == existing().date &&
          incoming().dateEpochDay == existing().dateEpochDay &&
          incoming().createdAt == existing().createdAt &&
          canEditStudentAttendance(orgId, incoming().schoolId, incoming().className, incoming().section, incoming().dateEpochDay) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'entries', 'presentCount', 'absentCount', 'leaveCount', 'lateCount', 'halfDayCount', 'totalStudents',
            'updatedByUid', 'updatedByName', 'clientEditedAtMs', 'updatedAt'
          ]);

        allow delete: if isSignedIn() &&
          isValidId(attId) &&
          isOrgAdmin(orgId);
      }

      match /studentAttendanceEditLogs/{logId} {
        allow get: if isSignedIn() && isActiveMember(orgId) &&
          canAccessSchool(orgId, resource.data.schoolId) && (
            hasModuleView(orgId, 'attendance') ||
            isClassTeacherOfSection(orgId, resource.data.schoolId, resource.data.className, resource.data.section)
          );

        allow list: if isSignedIn() && isActiveMember(orgId) && (
          hasModuleView(orgId, 'attendance') ||
          (
            canAccessSchool(orgId, resource.data.schoolId) &&
            isClassTeacherOfSection(orgId, resource.data.schoolId, resource.data.className, resource.data.section)
          )
        );

        allow create: if isSignedIn() &&
          isValidId(logId) &&
          isValidStudentAttendanceEditLog(incoming()) && (
            isOrgAdmin(orgId) ||
            (
              canAccessSchool(orgId, incoming().schoolId) && (
                hasModuleEdit(orgId, 'attendance') ||
                isClassTeacherOfSection(orgId, incoming().schoolId, incoming().className, incoming().section)
              )
            )
          );

        allow update: if false;
        allow delete: if false;
      }

      // -----------------------------------------------------------------------
      // 3k. PHASE 9: FEE MANAGEMENT (10th module 'fees')
      // - feeStructures: per-school + session fee heads, exam fees, catalogue, concession limit, templates
      // - studentFeeOverrides: per-student fee overrides with mandatory remark
      // - feeReceipts: immutable receipts (create only when status == ISSUED and amounts are positive;
      //   update only allows ISSUED -> CANCELLED with mandatory cancelReason; delete is always false)
      // - feeMessageSentLogs: guardian WhatsApp/SMS sent logs for Send Queue
      // - schoolNotices: notices created in Notice Maker
      // - feeAuditLogs: append-only fee audit trail
      // -----------------------------------------------------------------------
      match /feeStructures/{structureId} {
        allow get, list: if isSignedIn() && (
          hasModuleView(orgId, 'fees') ||
          hasModuleView(orgId, 'stock') ||
          hasModuleView(orgId, 'exams')
        );

        allow create: if isSignedIn() &&
          isValidId(structureId) &&
          isValidFeeStructure(incoming()) &&
          (hasModuleEdit(orgId, 'fees') || hasModuleEdit(orgId, 'stock')) &&
          canAccessSchool(orgId, incoming().schoolId);

        allow update: if isSignedIn() &&
          isValidId(structureId) &&
          isValidFeeStructure(incoming()) &&
          incoming().schoolId == existing().schoolId &&
          incoming().session == existing().session &&
          incoming().createdAt == existing().createdAt &&
          canAccessSchool(orgId, incoming().schoolId) && (
            hasModuleEdit(orgId, 'fees') ||
            (
              // Phase 11 Stock: Stock editor may ONLY update the shared optionalCatalogue + audit fields
              hasModuleEdit(orgId, 'stock') &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'optionalCatalogue', 'updatedByUid', 'updatedByName', 'clientEditedAtMs', 'updatedAt'
              ])
            )
          );

        allow delete: if isSignedIn() &&
          isValidId(structureId) &&
          isOrgAdmin(orgId);
      }

      match /studentFeeOverrides/{overrideId} {
        allow get, list: if isSignedIn() && (
          hasModuleView(orgId, 'fees') ||
          hasModuleView(orgId, 'exams')
        );

        allow create: if isSignedIn() &&
          isValidId(overrideId) &&
          isValidStudentFeeOverride(incoming()) &&
          hasModuleEdit(orgId, 'fees') &&
          canAccessSchool(orgId, incoming().schoolId);

        allow update: if isSignedIn() &&
          isValidId(overrideId) &&
          isValidStudentFeeOverride(incoming()) &&
          incoming().schoolId == existing().schoolId &&
          incoming().session == existing().session &&
          incoming().studentId == existing().studentId &&
          incoming().createdAt == existing().createdAt &&
          hasModuleEdit(orgId, 'fees') &&
          canAccessSchool(orgId, incoming().schoolId);

        allow delete: if isSignedIn() &&
          isValidId(overrideId) &&
          hasModuleEdit(orgId, 'fees') &&
          canAccessSchool(orgId, existing().schoolId);
      }

      match /feeReceipts/{receiptId} {
        allow get, list: if isSignedIn() && (
          hasModuleView(orgId, 'fees') ||
          hasModuleView(orgId, 'cashBook') ||
          hasModuleView(orgId, 'stock') ||
          hasModuleView(orgId, 'exams')
        );

        allow create: if isSignedIn() &&
          isValidId(receiptId) &&
          isValidFeeReceiptCreate(incoming()) &&
          hasModuleEdit(orgId, 'fees') &&
          canAccessSchool(orgId, incoming().schoolId) &&
          canIssueReceiptWithConcession(orgId, incoming());

        // Issued receipts can NEVER be edited (no amount, line item, or receiptNumber changes).
        // The ONLY allowed update is cancelling an ISSUED receipt with a mandatory cancelReason.
        allow update: if isSignedIn() &&
          isValidId(receiptId) &&
          hasModuleEdit(orgId, 'fees') &&
          canAccessSchool(orgId, existing().schoolId) &&
          existing().status == 'ISSUED' &&
          incoming().status == 'CANCELLED' &&
          incoming().cancelledByUid == request.auth.uid &&
          incoming().cancelledByName is string &&
          incoming().cancelledByName.size() >= 1 &&
          incoming().cancelledByName.size() <= 120 &&
          incoming().cancelledAtMs is int &&
          incoming().cancelledAtMs > 0 &&
          incoming().cancelReason is string &&
          incoming().cancelReason.size() >= 1 &&
          incoming().cancelReason.size() <= 300 &&
          isValidTimestamp(incoming().updatedAt) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'status', 'cancelledAtMs', 'cancelledByUid', 'cancelledByName', 'cancelReason', 'updatedAt'
          ]);

        // Receipts are NEVER deleted
        allow delete: if false;
      }

      match /feeMessageSentLogs/{logId} {
        allow get, list: if isSignedIn() && hasModuleView(orgId, 'fees');

        allow create: if isSignedIn() &&
          isValidId(logId) &&
          isValidFeeMessageSentLog(incoming()) &&
          hasModuleEdit(orgId, 'fees') &&
          canAccessSchool(orgId, incoming().schoolId);

        allow update: if isSignedIn() &&
          isValidId(logId) &&
          isValidFeeMessageSentLog(incoming()) &&
          incoming().schoolId == existing().schoolId &&
          incoming().session == existing().session &&
          incoming().studentId == existing().studentId &&
          incoming().createdAt == existing().createdAt &&
          hasModuleEdit(orgId, 'fees') &&
          canAccessSchool(orgId, incoming().schoolId);

        allow delete: if isSignedIn() &&
          isValidId(logId) &&
          isOrgAdmin(orgId);
      }

      match /schoolNotices/{noticeId} {
        allow get, list: if isSignedIn() && hasModuleView(orgId, 'fees');

        allow create: if isSignedIn() &&
          isValidId(noticeId) &&
          isValidSchoolNotice(incoming()) &&
          hasModuleEdit(orgId, 'fees') &&
          canAccessSchool(orgId, incoming().schoolId);

        allow update: if isSignedIn() &&
          isValidId(noticeId) &&
          isValidSchoolNotice(incoming()) &&
          incoming().schoolId == existing().schoolId &&
          incoming().createdAt == existing().createdAt &&
          hasModuleEdit(orgId, 'fees') &&
          canAccessSchool(orgId, incoming().schoolId);

        allow delete: if isSignedIn() &&
          isValidId(noticeId) &&
          hasModuleEdit(orgId, 'fees') &&
          canAccessSchool(orgId, existing().schoolId);
      }

      match /feeAuditLogs/{auditId} {
        allow get, list: if isSignedIn() && hasModuleView(orgId, 'fees');

        allow create: if isSignedIn() &&
          isValidId(auditId) &&
          isValidFeeAuditLog(incoming()) &&
          hasModuleEdit(orgId, 'fees') &&
          canAccessSchool(orgId, incoming().schoolId);

        allow update: if false;
        allow delete: if false;
      }

      // -----------------------------------------------------------------------
      // 3l. PHASE 10: CERTIFICATES ('certificates'), CASH BOOK ('cashBook'),
      //     AND ADMISSION ENQUIRY ('enquiry')
      // Missing permission key = NO ACCESS (handled by hasModuleView/Edit).
      // -----------------------------------------------------------------------
      match /schoolCertificates/{certId} {
        allow get, list: if isSignedIn() && hasModuleView(orgId, 'certificates');

        allow create: if isSignedIn() &&
          isValidId(certId) &&
          isValidSchoolCertificateCreate(incoming()) &&
          hasModuleEdit(orgId, 'certificates') &&
          canAccessSchool(orgId, incoming().schoolId);

        // Issued certificates can NEVER be edited; ONLY ISSUED -> CANCELLED with mandatory reason.
        allow update: if isSignedIn() &&
          isValidId(certId) &&
          hasModuleEdit(orgId, 'certificates') &&
          canAccessSchool(orgId, existing().schoolId) &&
          existing().status == 'ISSUED' &&
          incoming().status == 'CANCELLED' &&
          incoming().cancelledByUid == request.auth.uid &&
          incoming().cancelledByName is string &&
          incoming().cancelledByName.size() >= 1 &&
          incoming().cancelledByName.size() <= 120 &&
          incoming().cancelledAtMs is int &&
          incoming().cancelledAtMs > 0 &&
          incoming().cancelReason is string &&
          incoming().cancelReason.size() >= 1 &&
          incoming().cancelReason.size() <= 300 &&
          isValidTimestamp(incoming().updatedAt) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'status', 'cancelledAtMs', 'cancelledByUid', 'cancelledByName', 'cancelReason', 'updatedAt'
          ]);

        // Certificates are NEVER deleted
        allow delete: if false;
      }

      match /cashBookSettings/{settingId} {
        allow get, list: if isSignedIn() && hasModuleView(orgId, 'cashBook');

        allow create: if isSignedIn() &&
          isValidId(settingId) &&
          isValidCashBookSettings(incoming()) &&
          hasModuleEdit(orgId, 'cashBook') &&
          canAccessSchool(orgId, incoming().schoolId) &&
          (isOrgAdmin(orgId) || incoming().expenseApprovalLimitRs == 5000);

        allow update: if isSignedIn() &&
          isValidId(settingId) &&
          isValidCashBookSettings(incoming()) &&
          incoming().schoolId == existing().schoolId &&
          incoming().createdAt == existing().createdAt &&
          hasModuleEdit(orgId, 'cashBook') &&
          canAccessSchool(orgId, incoming().schoolId) &&
          (isOrgAdmin(orgId) || incoming().expenseApprovalLimitRs == existing().expenseApprovalLimitRs);

        allow delete: if false;
      }

      match /cashBookEntries/{entryId} {
        allow get, list: if isSignedIn() && hasModuleView(orgId, 'cashBook');

        allow create: if isSignedIn() &&
          isValidId(entryId) &&
          isValidCashBookEntryCreate(incoming()) &&
          hasModuleEdit(orgId, 'cashBook') &&
          canAccessSchool(orgId, incoming().schoolId) &&
          canRecordCashBookExpense(orgId, incoming());

        // Edit or Cancel an ACTIVE entry ONLY with mandatory reason; nothing silently deleted.
        allow update: if isSignedIn() &&
          isValidId(entryId) &&
          hasModuleEdit(orgId, 'cashBook') &&
          canAccessSchool(orgId, existing().schoolId) &&
          existing().status == 'ACTIVE' &&
          incoming().schoolId == existing().schoolId &&
          incoming().dateIso == existing().dateIso &&
          incoming().entryType == existing().entryType &&
          incoming().createdByUid == existing().createdByUid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedByUid == request.auth.uid &&
          incoming().updatedByName is string && incoming().updatedByName.size() >= 1 && incoming().updatedByName.size() <= 120 &&
          incoming().clientEditedAtMs is int && incoming().clientEditedAtMs >= 0 &&
          isValidTimestamp(incoming().updatedAt) && (
            // Branch A: Edit active entry with mandatory lastEditReason + approval check
            (
              incoming().status == 'ACTIVE' &&
              incoming().category is string && incoming().category.size() >= 1 && incoming().category.size() <= 80 &&
              incoming().amount is int && incoming().amount > 0 && incoming().amount <= 100000000 &&
              incoming().paymentMode in ['CASH', 'UPI', 'CHEQUE', 'OTHER'] &&
              incoming().note is string && incoming().note.size() <= 300 &&
              incoming().billPhotoBase64 is string && incoming().billPhotoBase64.size() <= 260000 &&
              incoming().lastEditReason is string && incoming().lastEditReason.size() >= 1 && incoming().lastEditReason.size() <= 300 &&
              canRecordCashBookExpense(orgId, incoming()) &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'category', 'amount', 'paymentMode', 'note', 'billPhotoBase64',
                'approvedByAdminUid', 'approvedByAdminName', 'approvalNote',
                'updatedByUid', 'updatedByName', 'lastEditReason', 'clientEditedAtMs', 'updatedAt'
              ])
            ) || (
              // Branch B: Cancel active entry with mandatory cancelReason
              incoming().status == 'CANCELLED' &&
              incoming().cancelledByUid == request.auth.uid &&
              incoming().cancelledByName is string && incoming().cancelledByName.size() >= 1 && incoming().cancelledByName.size() <= 120 &&
              incoming().cancelledAtMs is int && incoming().cancelledAtMs > 0 &&
              incoming().cancelReason is string && incoming().cancelReason.size() >= 1 && incoming().cancelReason.size() <= 300 &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'status', 'cancelledAtMs', 'cancelledByUid', 'cancelledByName', 'cancelReason',
                'updatedByUid', 'updatedByName', 'clientEditedAtMs', 'updatedAt'
              ])
            )
          );

        // Cash book entries are NEVER silently deleted
        allow delete: if false;
      }

      match /cashBookDayClosings/{closingId} {
        allow get, list: if isSignedIn() && hasModuleView(orgId, 'cashBook');

        allow create: if isSignedIn() &&
          isValidId(closingId) &&
          isValidCashBookDayClosing(incoming()) &&
          hasModuleEdit(orgId, 'cashBook') &&
          canAccessSchool(orgId, incoming().schoolId);

        allow update: if isSignedIn() &&
          isValidId(closingId) &&
          isValidCashBookDayClosing(incoming()) &&
          incoming().schoolId == existing().schoolId &&
          incoming().dateIso == existing().dateIso &&
          incoming().createdAt == existing().createdAt &&
          hasModuleEdit(orgId, 'cashBook') &&
          canAccessSchool(orgId, incoming().schoolId);

        allow delete: if false;
      }

      match /cashBookAuditLogs/{logId} {
        allow get, list: if isSignedIn() && hasModuleView(orgId, 'cashBook');

        allow create: if isSignedIn() &&
          isValidId(logId) &&
          isValidCashBookAuditLog(incoming()) &&
          hasModuleEdit(orgId, 'cashBook') &&
          canAccessSchool(orgId, incoming().schoolId);

        allow update: if false;
        allow delete: if false;
      }

      match /enquirySettings/{settingId} {
        allow get, list: if isSignedIn() && hasModuleView(orgId, 'enquiry');

        allow create: if isSignedIn() &&
          isValidId(settingId) &&
          isValidEnquirySettings(incoming()) &&
          hasModuleEdit(orgId, 'enquiry') &&
          canAccessSchool(orgId, incoming().schoolId);

        allow update: if isSignedIn() &&
          isValidId(settingId) &&
          isValidEnquirySettings(incoming()) &&
          incoming().schoolId == existing().schoolId &&
          incoming().createdAt == existing().createdAt &&
          hasModuleEdit(orgId, 'enquiry') &&
          canAccessSchool(orgId, incoming().schoolId);

        allow delete: if false;
      }

      match /admissionEnquiries/{enquiryId} {
        allow get, list: if isSignedIn() && hasModuleView(orgId, 'enquiry');

        allow create: if isSignedIn() &&
          isValidId(enquiryId) &&
          isValidAdmissionEnquiry(incoming()) &&
          incoming().createdByUid == request.auth.uid &&
          hasModuleEdit(orgId, 'enquiry') &&
          canAccessSchool(orgId, incoming().schoolId);

        allow update: if isSignedIn() &&
          isValidId(enquiryId) &&
          isValidAdmissionEnquiry(incoming()) &&
          incoming().schoolId == existing().schoolId &&
          incoming().createdByUid == existing().createdByUid &&
          incoming().createdAt == existing().createdAt &&
          hasModuleEdit(orgId, 'enquiry') &&
          canAccessSchool(orgId, incoming().schoolId);

        allow delete: if isSignedIn() &&
          isValidId(enquiryId) &&
          isOrgAdmin(orgId);
      }

      // -----------------------------------------------------------------------
      // 3m. PHASE 11: EXAM SCHEDULE & ADMIT CARDS ('exams'), STOCK ('stock'),
      //     AND TRANSPORT ROUTES ('transport')
      // Missing key = 'none' (no access). Owner & Admin have full access.
      // -----------------------------------------------------------------------

      match /examSchedules/{examId} {
        allow get, list: if isSignedIn() && hasModuleView(orgId, 'exams');

        allow create: if isSignedIn() &&
          isValidId(examId) &&
          isValidExamSchedule(incoming()) &&
          hasModuleEdit(orgId, 'exams') &&
          canAccessSchool(orgId, incoming().schoolId);

        allow update: if isSignedIn() &&
          isValidId(examId) &&
          isValidExamSchedule(incoming()) &&
          incoming().schoolId == existing().schoolId &&
          hasModuleEdit(orgId, 'exams') &&
          canAccessSchool(orgId, incoming().schoolId);

        allow delete: if isSignedIn() &&
          isValidId(examId) &&
          hasModuleEdit(orgId, 'exams') &&
          canAccessSchool(orgId, existing().schoolId);
      }

      match /examRooms/{roomId} {
        allow get, list: if isSignedIn() && hasModuleView(orgId, 'exams');

        allow create, update: if isSignedIn() &&
          isValidId(roomId) &&
          isValidExamRoom(incoming()) &&
          hasModuleEdit(orgId, 'exams') &&
          canAccessSchool(orgId, incoming().schoolId);

        allow delete: if isSignedIn() &&
          isValidId(roomId) &&
          hasModuleEdit(orgId, 'exams') &&
          canAccessSchool(orgId, existing().schoolId);
      }

      match /examSeatings/{seatingId} {
        allow get, list: if isSignedIn() && hasModuleView(orgId, 'exams');

        allow create, update: if isSignedIn() &&
          isValidId(seatingId) &&
          isValidExamSeating(incoming()) &&
          hasModuleEdit(orgId, 'exams') &&
          canAccessSchool(orgId, incoming().schoolId);

        allow delete: if isSignedIn() &&
          isValidId(seatingId) &&
          hasModuleEdit(orgId, 'exams') &&
          canAccessSchool(orgId, existing().schoolId);
      }

      match /examInvigilatorDuties/{dutyId} {
        // Exams viewers see all duties; any active linked teacher can read ONLY their own duties for Teacher Home
        allow get, list: if isSignedIn() && (
          hasModuleView(orgId, 'exams') ||
          (isActiveMember(orgId) && resource.data.teacherUid == request.auth.uid)
        );

        allow create, update: if isSignedIn() &&
          isValidId(dutyId) &&
          isValidExamInvigilatorDuty(incoming()) &&
          hasModuleEdit(orgId, 'exams') &&
          canAccessSchool(orgId, incoming().schoolId);

        allow delete: if isSignedIn() &&
          isValidId(dutyId) &&
          hasModuleEdit(orgId, 'exams') &&
          canAccessSchool(orgId, existing().schoolId);
      }

      match /stockTransactions/{txId} {
        allow get, list: if isSignedIn() && hasModuleView(orgId, 'stock');

        allow create: if isSignedIn() &&
          isValidId(txId) &&
          isValidStockTransaction(incoming()) &&
          hasModuleEdit(orgId, 'stock') &&
          canAccessSchool(orgId, incoming().schoolId);

        // Append-only audit trail for stock movements
        allow update: if false;
        allow delete: if false;
      }

      match /transportRoutes/{routeId} {
        allow get, list: if isSignedIn() && (
          hasModuleView(orgId, 'transport') ||
          hasModuleView(orgId, 'studentRegister')
        );

        allow create, update: if isSignedIn() &&
          isValidId(routeId) &&
          isValidTransportRoute(incoming()) &&
          hasModuleEdit(orgId, 'transport') &&
          canAccessSchool(orgId, incoming().schoolId);

        allow delete: if isSignedIn() &&
          isValidId(routeId) &&
          hasModuleEdit(orgId, 'transport') &&
          canAccessSchool(orgId, existing().schoolId);
      }
    }
  }
}
