rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // PRIMITIVES & COMPACT FIELD HELPERS
    // =========================================================================
    function isSignedIn() { return request.auth != null; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function strM(v, maxL) { return v is string && v.size() <= maxL; }
    function strR(v, minL, maxL) { return v is string && v.size() >= minL && v.size() <= maxL; }
    function int0(v) { return v is int && v >= 0; }
    function intR(v, minV, maxV) { return v is int && v >= minV && v <= maxV; }
    function listM(v, maxL) { return v is list && v.size() <= maxL; }
    function listR(v, minL, maxL) { return v is list && v.size() >= minL && v.size() <= maxL; }
    function mapM(v, maxL) { return v is map && v.size() <= maxL; }

    function optStr(d, k, m) { return !(k in d) || (d[k] is string && d[k].size() <= m); }
    function optInt(d, k, a, b) { return !(k in d) || (d[k] is int && d[k] >= a && d[k] <= b); }
    function optBool(d, k) { return !(k in d) || d[k] is bool; }
    function optTs(d, k) { return !(k in d) || (d[k] is timestamp && d[k] <= request.time); }

    function hasKeysExact(d, ks) { return d.size() == ks.size() && d.keys().hasAll(ks); }
    function hasKeysOpt(d, req, opt) { return d.keys().hasAll(req) && d.keys().hasOnly(req.concat(opt)); }
    function diffOnly(ks) { return incoming().diff(existing()).affectedKeys().hasOnly(ks); }

    function isValidId(id) { return strR(id, 1, 128) && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function okId(id) { return isSignedIn() && isValidId(id); }
    function isValidOrgCode(code) { return strR(code, 4, 30) && code.matches('^[a-z0-9][a-z0-9\\-]{2,28}[a-z0-9]$'); }
    function isValidTimestamp(ts) { return ts is timestamp && ts <= request.time; }
    function hasTs(d) { return isValidTimestamp(d.createdAt) && isValidTimestamp(d.updatedAt); }
    function isValidIsoDate(val) { return val is string && val.matches('^20[0-9]{2}-[0-1][0-9]-[0-3][0-9]$'); }
    function isValidYearMonth(ym) { return ym is string && ym.size() == 7 && ym.matches('^\\d{4}-\\d{2}$'); }
    function isPayMode(v) { return v in ['CASH', 'UPI', 'CHEQUE', 'OTHER']; }
    function isValidStringList(listVal, maxLen) {
      return listM(listVal, maxLen) && (listVal.size() == 0 || listVal[0] is string);
    }

    function isUpdUidMs(d) { return d.updatedByUid == request.auth.uid && int0(d.clientEditedAtMs) && isValidTimestamp(d.updatedAt); }
    function isUpdSelfStrict(d) { return strR(d.updatedByName, 1, 120) && isUpdUidMs(d); }
    function isUpdSelfFlex(d) { return strM(d.updatedByName, 120) && isUpdUidMs(d); }
    function hasCTs(d) { return isUpdSelfStrict(d) && isValidTimestamp(d.createdAt); }
    function hasFTs(d) { return isUpdSelfFlex(d) && isValidTimestamp(d.createdAt); }
    function isUpdNameMs(d) { return d.updatedByUid == request.auth.uid && strR(d.updatedByName, 1, 120) && int0(d.updatedAtMs) && isValidTimestamp(d.updatedAt); }
    function isCreatedBySelf(d) { return d.createdByUid == request.auth.uid && strR(d.createdByName, 1, 120) && int0(d.createdAtMs); }
    function isActorSelf(d) { return d.actorUid == request.auth.uid && strR(d.actorName, 1, 120); }
    function isSchSes(d) { return isValidId(d.schoolId) && strR(d.session, 4, 30); }
    function isClsSec(d, maxS) { return strR(d.className, 1, 40) && strR(d.section, 1, maxS); }
    function isZeroCancel(d) { return d.cancelledAtMs == 0 && d.cancelledByUid == '' && d.cancelledByName == ''; }
    function sameCr() { return incoming().createdAt == existing().createdAt; }
    function sameStu() { return incoming().studentId == existing().studentId; }
    function sameSchCr() { return incoming().schoolId == existing().schoolId && sameCr(); }
    function sameSchSesCr() { return sameSchCr() && incoming().session == existing().session; }

    function isValidPermissionsMap(perms) {
      return perms is map &&
        perms.size() >= 8 && perms.size() <= 23 &&
        perms.keys().hasAll(['students', 'marks', 'coScholastic', 'reports', 'timetable', 'teachers', 'settings', 'members']) &&
        perms.keys().hasOnly([
          'students', 'marks', 'coScholastic', 'reports', 'timetable', 'teachers', 'settings', 'members',
          'attendance', 'fees', 'studentRegister', 'certificates', 'cashBook', 'enquiry',
          'exams', 'stock', 'transport', 'salary', 'sessionPromotion', 'resultAnalysis',
          'classDiary', 'studentRemarks', 'gate'
        ]) &&
        perms.values().hasOnly(['none', 'view', 'edit']);
    }

    function isValidSettingsMap(s) {
      return s is map &&
        hasKeysExact(s, ['currentSession', 'sessionsCsv', 'passPercent', 'showPhotoAndAdmOnAnnual', 'showClassRank', 'lastBackupEpochMs']) &&
        strR(s.currentSession, 4, 30) && strR(s.sessionsCsv, 4, 500) &&
        intR(s.passPercent, 1, 100) && s.showPhotoAndAdmOnAnnual is bool && s.showClassRank is bool && int0(s.lastBackupEpochMs);
    }

    // =========================================================================
    // PATHS & RBAC HELPERS
    // =========================================================================
    function memberPath(orgId, uid) { return /databases/$(database)/documents/organisations/$(orgId)/members/$(uid); }
    function orgPath(orgId) { return /databases/$(database)/documents/organisations/$(orgId); }
    function teacherScopePath(orgId, uid) { return /databases/$(database)/documents/organisations/$(orgId)/teacherScopes/$(uid); }
    function schoolDocPath(orgId, schoolId) { return /databases/$(database)/documents/organisations/$(orgId)/schools/$(schoolId); }
    function studentDocPath(orgId, schoolId, studentId) { return /databases/$(database)/documents/organisations/$(orgId)/schools/$(schoolId)/students/$(studentId); }
    function invitePath(orgId, code) { return /databases/$(database)/documents/organisations/$(orgId)/inviteCodes/$(code); }
    function teacherDocPath(orgId, tid) { return /databases/$(database)/documents/organisations/$(orgId)/teachers/$(tid); }
    function cashBookSettingsPath(orgId, schoolId) { return /databases/$(database)/documents/organisations/$(orgId)/cashBookSettings/$('cbset_' + schoolId); }
    function salaryMonthLockPath(orgId, schoolId, ym) { return /databases/$(database)/documents/organisations/$(orgId)/salaryMonthLocks/$('sallock_' + schoolId + '_' + ym); }

    function memberExists(orgId) { return isSignedIn() && exists(memberPath(orgId, request.auth.uid)); }
    function memberData(orgId) { return get(memberPath(orgId, request.auth.uid)).data; }
    function isActiveMember(orgId) { return memberExists(orgId) && memberData(orgId).status == 'active'; }
    function isOrgOwner(orgId) { return memberExists(orgId) && memberData(orgId).status == 'active' && memberData(orgId).role == 'OWNER'; }
    function isOrgAdmin(orgId) { return memberExists(orgId) && memberData(orgId).status == 'active' && memberData(orgId).role in ['OWNER', 'ADMIN']; }
    function isOrgTeardown(orgId) { return isSignedIn() && isOrgOwner(orgId) && !existsAfter(orgPath(orgId)); }

    function mIsAdmin(m) { return m.role in ['OWNER', 'ADMIN']; }
    function mInSchool(m, schoolId) { return mIsAdmin(m) || m.allSchools == true || schoolId in m.schools; }
    function mActSch(m, schoolId) { return m.status == 'active' && mInSchool(m, schoolId); }
    function mView(m, k) { return k in m.permissions && m.permissions[k] in ['view', 'edit']; }
    function mEdit(m, k) { return k in m.permissions && m.permissions[k] == 'edit'; }

    function hasModuleView(orgId, k) {
      let m = memberData(orgId);
      return memberExists(orgId) && m.status == 'active' && (mIsAdmin(m) || mView(m, k));
    }
    function hasModuleEdit(orgId, k) {
      let m = memberData(orgId);
      return memberExists(orgId) && m.status == 'active' && (mIsAdmin(m) || mEdit(m, k));
    }
    function hasModuleView2(orgId, k1, k2) {
      let m = memberData(orgId);
      return memberExists(orgId) && m.status == 'active' && (mIsAdmin(m) || mView(m, k1) || mView(m, k2));
    }
    function hasModuleView3(orgId, k1, k2, k3) {
      let m = memberData(orgId);
      return memberExists(orgId) && m.status == 'active' && (mIsAdmin(m) || mView(m, k1) || mView(m, k2) || mView(m, k3));
    }
    function hasModuleView5(orgId, k1, k2, k3, k4, k5) {
      let m = memberData(orgId);
      return memberExists(orgId) && m.status == 'active' && (mIsAdmin(m) || mView(m, k1) || mView(m, k2) || mView(m, k3) || mView(m, k4) || mView(m, k5));
    }
    function hasModuleEdit2(orgId, k1, k2) {
      let m = memberData(orgId);
      return memberExists(orgId) && m.status == 'active' && (mIsAdmin(m) || mEdit(m, k1) || mEdit(m, k2));
    }
    function hasModuleEdit3(orgId, k1, k2, k3) {
      let m = memberData(orgId);
      return memberExists(orgId) && m.status == 'active' && (mIsAdmin(m) || mEdit(m, k1) || mEdit(m, k2) || mEdit(m, k3));
    }
    function canAccessSchool(orgId, schoolId) {
      let m = memberData(orgId);
      return memberExists(orgId) && mActSch(m, schoolId);
    }

    function isActiveAdminMember(orgId, uid) {
      let p = memberPath(orgId, uid);
      return uid != '' && exists(p) && get(p).data.status == 'active' && get(p).data.role in ['OWNER', 'ADMIN'];
    }

    function hasSalaryView(orgId) {
      let m = memberData(orgId);
      return memberExists(orgId) && m.status == 'active' && (m.role == 'OWNER' || mView(m, 'salary'));
    }
    function hasSalaryEdit(orgId) {
      let m = memberData(orgId);
      return memberExists(orgId) && m.status == 'active' && (m.role == 'OWNER' || mEdit(m, 'salary'));
    }
    function salaryPrivilegeNoneOrOwner(orgId, incomingPerms) {
      return isOrgOwner(orgId) || (!('salary' in incomingPerms) || incomingPerms.salary == 'none');
    }

    function canModSchoolWrite(orgId, mod, schoolId) {
      return hasModuleEdit(orgId, mod) && canAccessSchool(orgId, schoolId);
    }

    function canUpdateStudent(orgId, schoolId) {
      let m = memberData(orgId);
      let isAdmin = m.role in ['OWNER', 'ADMIN'];
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let canFullEdit = isAdmin ||
        ('students' in m.permissions && m.permissions.students == 'edit') ||
        ('studentRegister' in m.permissions && m.permissions.studentRegister == 'edit');
      return memberExists(orgId) && m.status == 'active' &&
        (isAdmin || m.allSchools == true || schoolId in m.schools) && (
        (canFullEdit && changed.hasOnly([
          'classId', 'session', 'admNo', 'name', 'fatherName', 'motherName',
          'dob', 'mobile', 'secondMobile', 'address', 'photoBase64', 'className', 'section',
          'rollNo', 'admissionDate', 'previousSchool', 'siblingGroupId',
          'usesTransport', 'transportRouteId', 'transportRouteName', 'transportStopId', 'transportStopName',
          'transportTripType', 'transportMonthlyAmount', 'transportStartMonth', 'transportEndMonth',
          'transportFeeOverridden', 'transportOverrideRemark', 'transportPriorMonthlyAmount',
          'transportFeeEffectiveFromMonth', 'status', 'leftDate', 'leftReason', 'sample', 'updatedAt'
        ])) ||
        (!canFullEdit && 'certificates' in m.permissions && m.permissions.certificates == 'edit' &&
          request.resource.data.status == 'LEFT' && changed.hasOnly(['status', 'leftDate', 'leftReason', 'updatedAt'])) ||
        (!canFullEdit && 'transport' in m.permissions && m.permissions.transport == 'edit' && changed.hasOnly([
          'usesTransport', 'transportRouteId', 'transportRouteName', 'transportStopId', 'transportStopName',
          'transportTripType', 'transportMonthlyAmount', 'transportStartMonth', 'transportEndMonth',
          'transportFeeOverridden', 'transportOverrideRemark', 'transportPriorMonthlyAmount',
          'transportFeeEffectiveFromMonth', 'updatedAt'
        ]))
      );
    }

    function isExamOpenForTeacher(orgId, schoolId, componentKey) {
      let sp = schoolDocPath(orgId, schoolId);
      let s = exists(sp) ? get(sp).data : {};
      let hasList = 'openExamsForTeachers' in s && s.openExamsForTeachers is list;
      return !hasList || (
        (componentKey == 'T1_UT' && ('UT1' in s.openExamsForTeachers || 'HALF_YEARLY' in s.openExamsForTeachers)) ||
        (componentKey == 'T2_UT' && ('UT2' in s.openExamsForTeachers || 'ANNUAL' in s.openExamsForTeachers)) ||
        (componentKey in ['T1_IA', 'T1_EXAM'] && 'HALF_YEARLY' in s.openExamsForTeachers) ||
        (componentKey in ['T2_IA', 'T2_EXAM'] && 'ANNUAL' in s.openExamsForTeachers)
      );
    }

    function canEditMarkScope(orgId, schoolId, studentId, className, subjectName, componentKey) {
      let m = memberData(orgId);
      let baseAllowed = memberExists(orgId) && mActSch(m, schoolId) && (mIsAdmin(m) || m.permissions.marks == 'edit');
      let isUnrestricted = mIsAdmin(m) || m.role != 'TEACHER';
      let tp = teacherScopePath(orgId, request.auth.uid);
      let stp = studentDocPath(orgId, schoolId, studentId);
      let hasScope = exists(tp);
      let teacherAssignedByScope = hasScope && exists(stp) &&
        (schoolId + '|' + get(stp).data.className + '|' + get(stp).data.section + '|' + subjectName) in get(tp).data.assignedClassSectionSubjects;
      let teacherAssignedLegacy = !hasScope && m.assignedClassSubjects.size() > 0 &&
        (schoolId + '|' + className + '|' + subjectName) in m.assignedClassSubjects;
      return baseAllowed && (isUnrestricted || (isExamOpenForTeacher(orgId, schoolId, componentKey) && (teacherAssignedByScope || teacherAssignedLegacy)));
    }

    function hasAnyTeacherSubjectScope(orgId) {
      let m = memberData(orgId);
      let tp = teacherScopePath(orgId, request.auth.uid);
      let hasScope = exists(tp);
      return (hasScope && get(tp).data.assignedClassSectionSubjects.size() > 0) || (!hasScope && m.assignedClassSubjects.size() > 0);
    }

    function canTeacherReadMarkByScope(orgId, schoolId, data) {
      let m = memberData(orgId);
      let tp = teacherScopePath(orgId, request.auth.uid);
      let stp = studentDocPath(orgId, schoolId, data.studentId);
      let hasScope = exists(tp);
      let hasStudent = exists(stp);
      let st = hasStudent ? get(stp).data : {};
      let scopedMatch = hasScope && hasStudent &&
        (schoolId + '|' + st.className + '|' + st.section + '|' + data.subjectName) in get(tp).data.assignedClassSectionSubjects;
      let legacyMatch = !hasScope && m.assignedClassSubjects.size() > 0 &&
        (schoolId + '|' + data.className + '|' + data.subjectName) in m.assignedClassSubjects;
      return m.role != 'TEACHER' || scopedMatch || legacyMatch;
    }

    function canReadStudents(orgId, schoolId) {
      let m = memberData(orgId);
      let hasStd = mIsAdmin(m) || mView(m, 'students') || mView(m, 'studentRegister') ||
        mView(m, 'fees') || mView(m, 'certificates') || mView(m, 'enquiry') ||
        mView(m, 'exams') || mView(m, 'transport') || mView(m, 'marks') ||
        mView(m, 'coScholastic') || mView(m, 'reports') || mView(m, 'attendance') ||
        mView(m, 'sessionPromotion') || mView(m, 'classDiary') || mView(m, 'studentRemarks') || mView(m, 'gate');
      let hasResAnalysis = mView(m, 'resultAnalysis') && (m.role != 'TEACHER' || hasAnyTeacherSubjectScope(orgId));
      return memberExists(orgId) && mActSch(m, schoolId) && (
        hasStd || hasResAnalysis || hasAnyClassTeacherSection(orgId) || hasAnyTeacherSubjectScope(orgId)
      );
    }

    function canGetMark(orgId, schoolId, data) {
      let m = memberData(orgId);
      let hasFull = mIsAdmin(m) || mView(m, 'marks') || mView(m, 'reports') || mView(m, 'sessionPromotion');
      let hasScoped = mView(m, 'resultAnalysis') && canTeacherReadMarkByScope(orgId, schoolId, data);
      return memberExists(orgId) && mActSch(m, schoolId) && (hasFull || hasScoped);
    }

    function canListMarks(orgId, schoolId) {
      let m = memberData(orgId);
      let hasFull = mIsAdmin(m) || mView(m, 'marks') || mView(m, 'reports') || mView(m, 'sessionPromotion');
      let hasScoped = mView(m, 'resultAnalysis') && (m.role != 'TEACHER' || hasAnyTeacherSubjectScope(orgId));
      return memberExists(orgId) && mActSch(m, schoolId) && (hasFull || hasScoped);
    }

    function isClassTeacherOfStudent(orgId, schoolId, studentId) {
      let tp = teacherScopePath(orgId, request.auth.uid);
      let stp = studentDocPath(orgId, schoolId, studentId);
      return exists(tp) && exists(stp) &&
        (schoolId + '|' + get(stp).data.className + '|' + get(stp).data.section) in get(tp).data.classTeacherSections;
    }

    function canEditCoScholasticScope(orgId, schoolId, studentId) {
      let m = memberData(orgId);
      return memberExists(orgId) && mActSch(m, schoolId) && (mIsAdmin(m) || m.permissions.coScholastic == 'edit') &&
        (mIsAdmin(m) || m.role != 'TEACHER' || isClassTeacherOfStudent(orgId, schoolId, studentId));
    }

    function isClassTeacherOfSection(orgId, schoolId, className, section) {
      let tp = teacherScopePath(orgId, request.auth.uid);
      return isSignedIn() && exists(tp) && (schoolId + '|' + className + '|' + section) in get(tp).data.classTeacherSections;
    }

    function hasAnyClassTeacherSection(orgId) {
      let tp = teacherScopePath(orgId, request.auth.uid);
      return isSignedIn() && exists(tp) && get(tp).data.classTeacherSections.size() > 0;
    }

    function canEditSchoolCalendar(orgId, schoolId) {
      let m = memberData(orgId);
      return memberExists(orgId) && mActSch(m, schoolId) && (
        mIsAdmin(m) || mEdit(m, 'settings') || mEdit(m, 'sessionPromotion') || (m.role != 'TEACHER' && mEdit(m, 'attendance'))
      );
    }

    function canEditStudentAttendance(orgId, schoolId, className, section, dateEpochDay) {
      let m = memberData(orgId);
      let isUnlimited = mIsAdmin(m) || (m.role != 'TEACHER' && mEdit(m, 'attendance'));
      let isAllowedTeacher = mEdit(m, 'attendance') || isClassTeacherOfSection(orgId, schoolId, className, section);
      let sp = schoolDocPath(orgId, schoolId);
      let hasSchool = exists(sp);
      let s = hasSchool ? get(sp).data : {};
      let maxDaysBack = (hasSchool && 'classTeacherAttendanceEditDaysBack' in s && s.classTeacherAttendanceEditDaysBack is int) ? s.classTeacherAttendanceEditDaysBack : 7;
      let serverEpochDay = int(request.time.toMillis() / 86400000);
      let withinDateWindow = dateEpochDay <= (serverEpochDay + 1) && dateEpochDay >= (serverEpochDay - maxDaysBack - 1);
      return memberExists(orgId) && mActSch(m, schoolId) && (isUnlimited || (isAllowedTeacher && withinDateWindow));
    }

    function canRecalculateTermAttendance(orgId, schoolId, studentId) {
      let m = memberData(orgId);
      return memberExists(orgId) && mActSch(m, schoolId) && (
        mIsAdmin(m) || mEdit(m, 'attendance') || isClassTeacherOfStudent(orgId, schoolId, studentId)
      );
    }

    function isAppOwner() {
      return isSignedIn() && (
        ('appOwner' in request.auth.token && request.auth.token.appOwner == true) ||
        ('email' in request.auth.token && 'email_verified' in request.auth.token &&
          request.auth.token.email == 'vivekvishawkarma02@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    function isValidOrgSubscriptionMap(sub) {
      return sub is map &&
        hasKeysOpt(sub, ['status'], ['plan', 'expiresAt', 'autoRenewing', 'updatedAt', 'purchaseTokenHash']) &&
        sub.status in ['none', 'active', 'grace', 'on_hold', 'cancelled_active', 'expired', 'revoked'] &&
        optStr(sub, 'plan', 80) &&
        (!('expiresAt' in sub) || sub.expiresAt == null || sub.expiresAt is timestamp) &&
        optBool(sub, 'autoRenewing') &&
        (!('updatedAt' in sub) || sub.updatedAt == null || sub.updatedAt is timestamp) &&
        optStr(sub, 'purchaseTokenHash', 128);
    }

    function isValidAdsWatchedWindow(win) {
      return win is map &&
        hasKeysOpt(win, ['windowStartAt', 'countInWindow', 'dailyDateKey', 'dailyCount', 'totalCount', 'lastRewardedAt'], ['verifiedByServer']) &&
        win.windowStartAt is timestamp && intR(win.countInWindow, 1, 4) &&
        win.dailyDateKey is string && win.dailyDateKey.size() == 10 &&
        intR(win.dailyCount, 1, 8) && win.totalCount is int && win.totalCount >= 1 &&
        win.lastRewardedAt is timestamp && optBool(win, 'verifiedByServer');
    }

    function isValidRemoteAdsConfig(data) {
      return data is map &&
        data.keys().hasOnly([
          'globalEnabled', 'todayBannerEnabled', 'orgChooserBannerEnabled', 'schoolChooserBannerEnabled',
          'studentListBannerEnabled', 'teacherListBannerEnabled', 'reportListBannerEnabled', 'timetableViewBannerEnabled',
          'pdfCloseInterstitialEnabled', 'rewardedAdFreeEnabled', 'requireServerVerifiedRewards',
          'updatedAt', 'updatedByEmail'
        ]) &&
        optBool(data, 'globalEnabled') && optBool(data, 'todayBannerEnabled') &&
        optBool(data, 'orgChooserBannerEnabled') && optBool(data, 'schoolChooserBannerEnabled') &&
        optBool(data, 'studentListBannerEnabled') && optBool(data, 'teacherListBannerEnabled') &&
        optBool(data, 'reportListBannerEnabled') && optBool(data, 'timetableViewBannerEnabled') &&
        optBool(data, 'pdfCloseInterstitialEnabled') && optBool(data, 'rewardedAdFreeEnabled') &&
        optBool(data, 'requireServerVerifiedRewards') && optTs(data, 'updatedAt') && optStr(data, 'updatedByEmail', 160);
    }

    function isValidSelfAdFreeUpdate(inc, ex) {
      let hasWindow = 'adsWatchedWindow' in inc && isValidAdsWatchedWindow(inc.adsWatchedWindow);
      let hasUntil = 'adFreeUntil' in inc && inc.adFreeUntil is timestamp;
      let within24h = hasUntil && inc.adFreeUntil <= request.time + duration.value(24, 'h');
      let extendedOnly = hasUntil && (!('adFreeUntil' in ex) || inc.adFreeUntil >= ex.adFreeUntil);
      let serverTimestamped = hasWindow && inc.adsWatchedWindow.lastRewardedAt == request.time;
      let firstRewardValid = hasWindow && !('adsWatchedWindow' in ex) &&
        inc.adsWatchedWindow.totalCount == 1 && inc.adsWatchedWindow.countInWindow == 1 && inc.adsWatchedWindow.dailyCount == 1;
      let nextRewardValid = hasWindow && ('adsWatchedWindow' in ex) &&
        inc.adsWatchedWindow.totalCount >= ex.adsWatchedWindow.totalCount &&
        inc.adsWatchedWindow.totalCount <= ex.adsWatchedWindow.totalCount + 1 &&
        (inc.adsWatchedWindow.dailyDateKey > ex.adsWatchedWindow.dailyDateKey ||
          (inc.adsWatchedWindow.dailyDateKey == ex.adsWatchedWindow.dailyDateKey && inc.adsWatchedWindow.dailyCount >= ex.adsWatchedWindow.dailyCount)) &&
        (inc.adsWatchedWindow.windowStartAt > ex.adsWatchedWindow.windowStartAt ||
          (inc.adsWatchedWindow.windowStartAt == ex.adsWatchedWindow.windowStartAt && inc.adsWatchedWindow.countInWindow >= ex.adsWatchedWindow.countInWindow));
      return within24h && extendedOnly && serverTimestamped && (firstRewardValid || nextRewardValid);
    }

    function isSelfRewardedAdFreeUpdate(memberUid) {
      let inc = incoming();
      let ex = existing();
      return isSignedIn() && isValidId(memberUid) && request.auth.uid == memberUid && ex.status == 'active' &&
        inc.diff(ex).affectedKeys().hasOnly(['adFreeUntil', 'adsWatchedWindow', 'updatedAt']) &&
        isValidTimestamp(inc.updatedAt) && isValidSelfAdFreeUpdate(inc, ex);
    }

    function canInviteRedeemCreate(orgId, memberUid, inc) {
      let ip = invitePath(orgId, inc.inviteCodeUsed);
      let inv = get(ip).data;
      return request.auth.uid == memberUid && inc.role != 'OWNER' && inc.status == 'active' &&
