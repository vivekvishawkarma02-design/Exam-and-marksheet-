    function canUpdateCashBookEntry(orgId, entryId) {
      let inc = incoming();
      let ex = existing();
      let diff = inc.diff(ex).affectedKeys();
      let isTransport = ('sourceModule' in ex && ex.sourceModule == 'TRANSPORT') &&
        ('sourceModule' in inc && inc.sourceModule == 'TRANSPORT') && ex.entryType == 'EXPENSE';
      return okId(entryId) &&
        (hasModuleEdit(orgId, 'cashBook') || (hasModuleEdit(orgId, 'transport') && isTransport)) &&
        canAccessSchool(orgId, ex.schoolId) && ex.status == 'ACTIVE' &&
        inc.schoolId == ex.schoolId && inc.dateIso == ex.dateIso && inc.entryType == ex.entryType &&
        inc.createdByUid == ex.createdByUid && sameCr() &&
        !('sourceModule' in diff) && isUpdSelfStrict(inc) && (
          (inc.status == 'ACTIVE' && isCashBookBodyCore(inc) && strR(inc.lastEditReason, 1, 300) &&
            canRecordCashBookExpense(orgId, inc) &&
            diff.hasOnly([
              'category', 'amount', 'paymentMode', 'note', 'billPhotoBase64',
              'transportRouteId', 'vehicleNumber', 'transportCategory',
              'approvedByAdminUid', 'approvedByAdminName', 'approvalNote',
              'updatedByUid', 'updatedByName', 'lastEditReason', 'clientEditedAtMs', 'updatedAt'
            ])) ||
          (inc.status == 'CANCELLED' && inc.cancelledByUid == request.auth.uid && strR(inc.cancelledByName, 1, 120) &&
            inc.cancelledAtMs is int && inc.cancelledAtMs > 0 && strR(inc.cancelReason, 1, 300) &&
            diff.hasOnly([
              'status', 'cancelledAtMs', 'cancelledByUid', 'cancelledByName', 'cancelReason',
              'updatedByUid', 'updatedByName', 'clientEditedAtMs', 'updatedAt'
            ]))
        );
    }

    function isValidSimpleCrudDoc(col, data) {
