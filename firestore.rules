    function isValidFeeReceiptCreate(data) {
      return data.size() == 40 &&
        data.keys().hasAll([
          'schoolId', 'session', 'receiptNumber', 'deviceNodeCode', 'sequenceNo', 'receiptDateIso',
          'studentId', 'studentName', 'studentAdmNo', 'fatherName', 'className', 'section', 'rollNo',
          'lineItems', 'totalBeforeConcession', 'concessionMode', 'concessionScope',
          'concessionTargetLineId', 'concessionInputValue', 'concessionAmount', 'concessionRemark',
          'concessionGivenByUid', 'concessionGivenByName', 'concessionApprovedByAdminUid', 'concessionApprovedByAdminName',
          'netPayableAmount', 'amountPaid', 'balanceDueOnReceipt', 'paymentMode', 'paymentNote',
          'status', 'receivedByUid', 'receivedByName', 'issuedAtMs',
          'cancelledAtMs', 'cancelledByUid', 'cancelledByName', 'cancelReason',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.schoolId) &&
        data.session is string && data.session.size() >= 4 && data.session.size() <= 30 &&
        data.receiptNumber is string && data.receiptNumber.size() >= 3 && data.receiptNumber.size() <= 60 &&
        data.sequenceNo is int && data.sequenceNo >= 1 &&
        isValidIsoDate(data.receiptDateIso) &&
        isValidId(data.studentId) &&
        data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 120 &&
        data.className is string && data.className.size() >= 1 && data.className.size() <= 40 &&
        data.section is string && data.section.size() >= 1 && data.section.size() <= 10 &&
        data.rollNo is int && data.rollNo >= 1 && data.rollNo <= 9999 &&
        data.lineItems is list && data.lineItems.size() >= 1 && data.lineItems.size() <= 80 &&
        data.totalBeforeConcession is int && data.totalBeforeConcession > 0 &&
        data.concessionMode in ['NONE', 'RUPEES', 'PERCENTAGE'] &&
        data.concessionScope in ['WHOLE_RECEIPT', 'SINGLE_LINE'] &&
        data.concessionAmount is int &&
        data.concessionAmount >= 0 &&
        data.concessionAmount <= data.totalBeforeConcession &&
        data.concessionRemark is string && data.concessionRemark.size() <= 300 &&
        (data.concessionAmount == 0 || data.concessionRemark.size() >= 1) &&
        data.concessionApprovedByAdminUid is string && data.concessionApprovedByAdminUid.size() <= 128 &&
        data.netPayableAmount is int &&
        data.netPayableAmount >= 0 &&
        data.netPayableAmount == (data.totalBeforeConcession - data.concessionAmount) &&
        data.amountPaid is int &&
        data.amountPaid > 0 &&
        data.amountPaid <= data.netPayableAmount &&
        data.balanceDueOnReceipt is int &&
        data.balanceDueOnReceipt >= 0 &&
        data.balanceDueOnReceipt == (data.netPayableAmount - data.amountPaid) &&
        data.paymentMode in ['CASH', 'UPI', 'CHEQUE', 'OTHER'] &&
        data.status == 'ISSUED' &&
        data.receivedByUid == request.auth.uid &&
        data.receivedByName is string && data.receivedByName.size() >= 1 && data.receivedByName.size() <= 120 &&
        data.issuedAtMs is int && data.issuedAtMs >= 0 &&
        data.cancelledAtMs == 0 &&
        data.cancelledByUid == '' &&
        data.cancelledByName == '' &&
        data.cancelReason == '' &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function canIssueReceiptWithConcession(orgId, data) {
      return data.concessionAmount == 0 ||
        (data.concessionAmount * 100) <= (data.totalBeforeConcession * 20) ||
        isOrgAdmin(orgId) ||
        (
          data.concessionApprovedByAdminUid != '' &&
          exists(memberPath(orgId, data.concessionApprovedByAdminUid)) &&
          get(memberPath(orgId, data.concessionApprovedByAdminUid)).data.status == 'active' &&
          get(memberPath(orgId, data.concessionApprovedByAdminUid)).data.role in ['OWNER', 'ADMIN']
        );
    }

