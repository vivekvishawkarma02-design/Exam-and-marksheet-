          'createdByUid', 'createdByName', 'createdAtMs',
          'updatedByUid', 'updatedByName', 'clientEditedAtMs', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'schoolId', 'session', 'childName', 'classWanted', 'guardianName', 'mobile', 'source', 'notes',
          'enquiryDateIso', 'nextFollowUpDateIso', 'status', 'lostReason',
          'convertedStudentDocId', 'convertedStudentAdmNo', 'convertedAtMs',
          'createdByUid', 'createdByName', 'createdAtMs',
          'updatedByUid', 'updatedByName', 'clientEditedAtMs', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.schoolId) &&
        data.session is string && data.session.size() >= 4 && data.session.size() <= 30 &&
        data.childName is string && data.childName.size() >= 1 && data.childName.size() <= 120 &&
        data.classWanted is string && data.classWanted.size() <= 40 &&
