rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // GLOBAL PRIMITIVES & STATIC VALIDATORS
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidOrgCode(code) {
      return code is string && code.size() >= 4 && code.size() <= 30 && code.matches('^[a-z0-9][a-z0-9\\-]{2,28}[a-z0-9]$');
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isValidAccessLevel(lvl) {
      return lvl is string && lvl in ['none', 'view', 'edit'];
    }

    function isValidPermissionsMap(perms) {
      return perms is map &&
        perms.size() >= 8 && perms.size() <= 17 &&
        perms.keys().hasAll(['students', 'marks', 'coScholastic', 'reports', 'timetable', 'teachers', 'settings', 'members']) &&
        perms.keys().hasOnly([
          'students', 'marks', 'coScholastic', 'reports', 'timetable', 'teachers', 'settings', 'members',
          'attendance', 'fees', 'studentRegister',
          'certificates', 'cashBook', 'enquiry',
          'exams', 'stock', 'transport'
        ]) &&
        perms.students in ['none', 'view', 'edit'] &&
        perms.marks in ['none', 'view', 'edit'] &&
        perms.coScholastic in ['none', 'view', 'edit'] &&
        perms.reports in ['none', 'view', 'edit'] &&
        perms.timetable in ['none', 'view', 'edit'] &&
        perms.teachers in ['none', 'view', 'edit'] &&
        perms.settings in ['none', 'view', 'edit'] &&
        perms.members in ['none', 'view', 'edit'] &&
        (!('attendance' in perms) || perms.attendance in ['none', 'view', 'edit']) &&
        (!('fees' in perms) || perms.fees in ['none', 'view', 'edit']) &&
        (!('studentRegister' in perms) || perms.studentRegister in ['none', 'view', 'edit']) &&
        (!('certificates' in perms) || perms.certificates in ['none', 'view', 'edit']) &&
        (!('cashBook' in perms) || perms.cashBook in ['none', 'view', 'edit']) &&
        (!('enquiry' in perms) || perms.enquiry in ['none', 'view', 'edit']) &&
        (!('exams' in perms) || perms.exams in ['none', 'view', 'edit']) &&
        (!('stock' in perms) || perms.stock in ['none', 'view', 'edit']) &&
        (!('transport' in perms) || perms.transport in ['none', 'view', 'edit']);
    }

    function isValidStringList(listVal, maxLen) {
      return listVal is list && listVal.size() <= maxLen &&
        (listVal.size() == 0 || listVal[0] is string);
    }

    function isValidSettingsMap(s) {
      return s is map &&
        s.size() == 6 &&
        s.keys().hasAll(['currentSession', 'sessionsCsv', 'passPercent', 'showPhotoAndAdmOnAnnual', 'showClassRank', 'lastBackupEpochMs']) &&
        s.currentSession is string && s.currentSession.size() >= 4 && s.currentSession.size() <= 30 &&
        s.sessionsCsv is string && s.sessionsCsv.size() >= 4 && s.sessionsCsv.size() <= 500 &&
        s.passPercent is int && s.passPercent >= 1 && s.passPercent <= 100 &&
        s.showPhotoAndAdmOnAnnual is bool &&
        s.showClassRank is bool &&
        s.lastBackupEpochMs is int && s.lastBackupEpochMs >= 0;
    }

    // =========================================================================
    // RELATIONAL / RBAC HELPERS (Zero-trust, evaluated server-side)
    // =========================================================================
    function memberPath(orgId, uid) {
      return /databases/$(database)/documents/organisations/$(orgId)/members/$(uid);
    }

    function orgPath(orgId) {
      return /databases/$(database)/documents/organisations/$(orgId);
    }

    function memberExists(orgId) {
      return isSignedIn() && exists(memberPath(orgId, request.auth.uid));
    }

    function memberData(orgId) {
      return get(memberPath(orgId, request.auth.uid)).data;
    }

    function isActiveMember(orgId) {
      return memberExists(orgId) && memberData(orgId).status == 'active';
    }

    function isOrgOwner(orgId) {
      return memberExists(orgId) && memberData(orgId).status == 'active' && memberData(orgId).role == 'OWNER';
    }

    function isOrgAdmin(orgId) {
      return memberExists(orgId) && memberData(orgId).status == 'active' && memberData(orgId).role in ['OWNER', 'ADMIN'];
    }

    function hasModuleView(orgId, moduleKey) {
      let m = memberData(orgId);
      return memberExists(orgId) && m.status == 'active' && (
        m.role in ['OWNER', 'ADMIN'] ||
        (moduleKey in m.permissions && m.permissions[moduleKey] in ['view', 'edit'])
      );
    }

    function hasModuleEdit(orgId, moduleKey) {
      let m = memberData(orgId);
      return memberExists(orgId) && m.status == 'active' && (
        m.role in ['OWNER', 'ADMIN'] ||
        (moduleKey in m.permissions && m.permissions[moduleKey] == 'edit')
      );
    }

    function canAccessSchool(orgId, schoolId) {
      let m = memberData(orgId);
      return memberExists(orgId) && m.status == 'active' && (
        m.role in ['OWNER', 'ADMIN'] || m.allSchools == true || schoolId in m.schools
      );
    }

    function canUpdateStudent(orgId, schoolId) {
      let m = memberData(orgId);
      let isAdmin = m.role in ['OWNER', 'ADMIN'];
      let inSchool = isAdmin || m.allSchools == true || schoolId in m.schools;
      let changed = incoming().diff(existing()).affectedKeys();
      let canFullEdit = isAdmin ||
        ('students' in m.permissions && m.permissions.students == 'edit') ||
        ('studentRegister' in m.permissions && m.permissions.studentRegister == 'edit');
      let canCertMarkLeft = !canFullEdit &&
        'certificates' in m.permissions && m.permissions.certificates == 'edit' &&
        incoming().status == 'LEFT' &&
        changed.hasOnly(['status', 'leftDate', 'leftReason', 'updatedAt']);
      let canTransportEdit = !canFullEdit &&
        'transport' in m.permissions && m.permissions.transport == 'edit' &&
        changed.hasOnly(['usesTransport', 'transportRouteId', 'transportRouteName', 'transportStopName', 'transportMonthlyAmount', 'updatedAt']);
      return memberExists(orgId) && m.status == 'active' && inSchool && (
        (canFullEdit && changed.hasOnly([
          'classId', 'session', 'admNo', 'name', 'fatherName', 'motherName',
          'dob', 'mobile', 'secondMobile', 'address', 'photoBase64', 'className', 'section',
          'rollNo', 'admissionDate', 'previousSchool', 'siblingGroupId',
          'usesTransport', 'transportRouteId', 'transportRouteName', 'transportStopName', 'transportMonthlyAmount',
          'status', 'leftDate', 'leftReason',
          'sample', 'updatedAt'
        ])) ||
        canCertMarkLeft ||
        canTransportEdit
      );
    }

    function teacherScopePath(orgId, uid) {
      return /databases/$(database)/documents/organisations/$(orgId)/teacherScopes/$(uid);
    }

    function schoolDocPath(orgId, schoolId) {
      return /databases/$(database)/documents/organisations/$(orgId)/schools/$(schoolId);
    }

    function studentDocPath(orgId, schoolId, studentId) {
      return /databases/$(database)/documents/organisations/$(orgId)/schools/$(schoolId)/students/$(studentId);
    }

    function isExamOpenForTeacher(orgId, schoolId, componentKey) {
      let hasSchool = exists(schoolDocPath(orgId, schoolId));
      let s = hasSchool ? get(schoolDocPath(orgId, schoolId)).data : {};
      let hasList = 'openExamsForTeachers' in s && s.openExamsForTeachers is list;
      return !hasList || (
        (componentKey == 'T1_UT' && ('UT1' in s.openExamsForTeachers || 'HALF_YEARLY' in s.openExamsForTeachers)) ||
        (componentKey == 'T2_UT' && ('UT2' in s.openExamsForTeachers || 'ANNUAL' in s.openExamsForTeachers)) ||
        (componentKey in ['T1_IA', 'T1_EXAM'] && 'HALF_YEARLY' in s.openExamsForTeachers) ||
        (componentKey in ['T2_IA', 'T2_EXAM'] && 'ANNUAL' in s.openExamsForTeachers)
      );
    }

    function canEditMarkScope(orgId, schoolId, studentId, className, subjectName, componentKey) {
      let m = memberData(orgId);
      let baseAllowed = memberExists(orgId) && m.status == 'active' &&
        (m.role in ['OWNER', 'ADMIN'] || m.allSchools == true || schoolId in m.schools) &&
        (m.role in ['OWNER', 'ADMIN'] || m.permissions.marks == 'edit');
      let isUnrestricted = m.role in ['OWNER', 'ADMIN'] || m.role != 'TEACHER';
      let hasScope = exists(teacherScopePath(orgId, request.auth.uid));
      let teacherAssignedByScope = hasScope &&
        exists(studentDocPath(orgId, schoolId, studentId)) &&
        (schoolId + '|' + get(studentDocPath(orgId, schoolId, studentId)).data.className + '|' + get(studentDocPath(orgId, schoolId, studentId)).data.section + '|' + subjectName) in get(teacherScopePath(orgId, request.auth.uid)).data.assignedClassSectionSubjects;
      let teacherAssignedLegacy = !hasScope &&
        m.assignedClassSubjects.size() > 0 &&
        (schoolId + '|' + className + '|' + subjectName) in m.assignedClassSubjects;
      return baseAllowed && (
        isUnrestricted || (
          isExamOpenForTeacher(orgId, schoolId, componentKey) &&
          (teacherAssignedByScope || teacherAssignedLegacy)
        )
      );
    }

    function canEditCoScholasticScope(orgId, schoolId, studentId) {
      let m = memberData(orgId);
      let baseAllowed = memberExists(orgId) && m.status == 'active' &&
        (m.role in ['OWNER', 'ADMIN'] || m.allSchools == true || schoolId in m.schools) &&
        (m.role in ['OWNER', 'ADMIN'] || m.permissions.coScholastic == 'edit');
      let isUnrestricted = m.role in ['OWNER', 'ADMIN'] || m.role != 'TEACHER';
      let isClassTeacherForStudent = exists(teacherScopePath(orgId, request.auth.uid)) &&
        exists(studentDocPath(orgId, schoolId, studentId)) &&
        (schoolId + '|' + get(studentDocPath(orgId, schoolId, studentId)).data.className + '|' + get(studentDocPath(orgId, schoolId, studentId)).data.section) in get(teacherScopePath(orgId, request.auth.uid)).data.classTeacherSections;
      return baseAllowed && (isUnrestricted || isClassTeacherForStudent);
    }

    // Phase 8: Class teacher section isolation & student attendance edit rules
    function isClassTeacherOfSection(orgId, schoolId, className, section) {
      return isSignedIn() &&
        exists(teacherScopePath(orgId, request.auth.uid)) &&
        (schoolId + '|' + className + '|' + section) in get(teacherScopePath(orgId, request.auth.uid)).data.classTeacherSections;
    }

    function hasAnyClassTeacherSection(orgId) {
      return isSignedIn() &&
        exists(teacherScopePath(orgId, request.auth.uid)) &&
        get(teacherScopePath(orgId, request.auth.uid)).data.classTeacherSections.size() > 0;
    }

    function canEditSchoolCalendar(orgId, schoolId) {
      let m = memberData(orgId);
      return memberExists(orgId) && m.status == 'active' &&
        (m.role in ['OWNER', 'ADMIN'] || m.allSchools == true || schoolId in m.schools) && (
          m.role in ['OWNER', 'ADMIN'] ||
          hasModuleEdit(orgId, 'settings') ||
          (m.role != 'TEACHER' && hasModuleEdit(orgId, 'attendance'))
        );
    }

    function canEditStudentAttendance(orgId, schoolId, className, section, dateEpochDay) {
      let m = memberData(orgId);
      let activeAndSchool = memberExists(orgId) && m.status == 'active' &&
        (m.role in ['OWNER', 'ADMIN'] || m.allSchools == true || schoolId in m.schools);
      let isUnlimited = m.role in ['OWNER', 'ADMIN'] ||
        (m.role != 'TEACHER' && hasModuleEdit(orgId, 'attendance'));
      let isAllowedTeacher = hasModuleEdit(orgId, 'attendance') ||
        isClassTeacherOfSection(orgId, schoolId, className, section);
      let hasSchool = exists(schoolDocPath(orgId, schoolId));
      let s = hasSchool ? get(schoolDocPath(orgId, schoolId)).data : {};
      let maxDaysBack = (hasSchool && 'classTeacherAttendanceEditDaysBack' in s && s.classTeacherAttendanceEditDaysBack is int)
        ? s.classTeacherAttendanceEditDaysBack
        : 7;
      let serverEpochDay = int(request.time.toMillis() / 86400000);
      // +/- 1 day UTC timezone buffer so local dates never false-reject across time zones
      let withinDateWindow = dateEpochDay <= (serverEpochDay + 1) &&
        dateEpochDay >= (serverEpochDay - maxDaysBack - 1);
      return activeAndSchool && (
        isUnlimited || (isAllowedTeacher && withinDateWindow)
      );
    }

    function canRecalculateTermAttendance(orgId, schoolId, studentId) {
      let m = memberData(orgId);
      let activeAndSchool = memberExists(orgId) && m.status == 'active' &&
        (m.role in ['OWNER', 'ADMIN'] || m.allSchools == true || schoolId in m.schools);
      let isClassTeacherForStudent = exists(teacherScopePath(orgId, request.auth.uid)) &&
        exists(studentDocPath(orgId, schoolId, studentId)) &&
        (schoolId + '|' + get(studentDocPath(orgId, schoolId, studentId)).data.className + '|' + get(studentDocPath(orgId, schoolId, studentId)).data.section) in get(teacherScopePath(orgId, request.auth.uid)).data.classTeacherSections;
      return activeAndSchool && (
        m.role in ['OWNER', 'ADMIN'] ||
        hasModuleEdit(orgId, 'attendance') ||
        isClassTeacherForStudent
      );
    }

    function canUpdateMember(orgId, memberUid) {
      let inc = request.resource.data;
      let ex = resource.data;
      let diffKeys = inc.diff(ex).affectedKeys();
      let isSelf = request.auth.uid == memberUid &&
        ex.status == 'active' &&
        inc.role == ex.role &&
        inc.status == ex.status &&
        inc.allSchools == ex.allSchools &&
        inc.schools == ex.schools &&
        inc.permissions == ex.permissions &&
        inc.assignedClassSubjects == ex.assignedClassSubjects &&
        diffKeys.hasOnly([
          'name', 'mobile', 'teacherProfileCompleted', 'teacherPhotoBase64',
          'requestedSubjects', 'requestedClasses', 'lastActiveAt', 'updatedAt'
        ]);
      let actor = memberData(orgId);
      let actorActive = memberExists(orgId) && actor.status == 'active';
      let actorAdmin = actorActive && actor.role in ['OWNER', 'ADMIN'];
      let actorCanManage = actorAdmin || (actorActive && actor.permissions.members == 'edit');
      let isAdminManage = actorCanManage &&
        ex.role != 'OWNER' &&
        inc.role != 'OWNER' &&
        diffKeys.hasOnly([
          'role', 'status', 'allSchools', 'schools', 'permissions',
          'assignedClassSubjects', 'updatedAt'
        ]);
      let isOwnershipTransfer = actorActive && actor.role == 'OWNER' &&
        inc.status == 'active' &&
        diffKeys.hasOnly(['role', 'allSchools', 'permissions', 'updatedAt']) &&
        getAfter(orgPath(orgId)).data.ownerUid != request.auth.uid && (
          (memberUid == getAfter(orgPath(orgId)).data.ownerUid && inc.role == 'OWNER' && inc.allSchools == true) ||
          (memberUid == request.auth.uid && ex.role == 'OWNER' && inc.role == 'ADMIN')
        );
      return isSelf || isAdminManage || isOwnershipTransfer;
    }

    // =========================================================================
    // ENTITY VALIDATION BLUEPRINTS
    // =========================================================================
    function isValidUserAccount(data, uid) {
      return data.keys().hasAll(['uid', 'name', 'email', 'memberships', 'pendingRequests', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'name', 'email', 'memberships', 'pendingRequests', 'createdAt', 'updatedAt']) &&
        data.uid == uid &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.email is string && data.email.size() <= 160 &&
        data.memberships is list && data.memberships.size() <= 30 &&
        data.pendingRequests is list && data.pendingRequests.size() <= 20 &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidOrgCodeReservation(data) {
      return data.keys().hasAll(['orgId', 'name', 'ownerUid', 'createdAt']) &&
        data.keys().hasOnly(['orgId', 'name', 'ownerUid', 'createdAt']) &&
        isValidId(data.orgId) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 120 &&
        data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
        isValidTimestamp(data.createdAt);
    }

    function isValidOrganisation(data) {
      return data.keys().hasAll(['name', 'code', 'ownerUid', 'contactMobile', 'contactEmail', 'settings', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['name', 'code', 'ownerUid', 'contactMobile', 'contactEmail', 'settings', 'createdAt', 'updatedAt']) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 120 &&
        isValidOrgCode(data.code) &&
        data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
        data.contactMobile is string && data.contactMobile.size() <= 40 &&
        data.contactEmail is string && data.contactEmail.size() <= 160 &&
        isValidSettingsMap(data.settings) &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidMember(data, memberUid) {
      return data.keys().hasAll([
          'uid', 'name', 'email', 'mobile', 'role', 'status',
          'allSchools', 'schools', 'permissions',
          'teacherProfileCompleted', 'teacherPhotoBase64',
          'requestedSubjects', 'requestedClasses', 'assignedClassSubjects',
          'lastActiveAt', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'name', 'email', 'mobile', 'role', 'status',
          'allSchools', 'schools', 'permissions',
          'teacherProfileCompleted', 'teacherPhotoBase64',
          'requestedSubjects', 'requestedClasses', 'assignedClassSubjects',
          'inviteCodeUsed', 'lastActiveAt', 'createdAt', 'updatedAt'
        ]) &&
        data.uid == memberUid &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.email is string && data.email.size() <= 160 &&
        data.mobile is string && data.mobile.size() <= 40 &&
        data.role in ['OWNER', 'ADMIN', 'OFFICE_OPERATOR', 'TEACHER', 'OTHER'] &&
        data.status in ['active', 'removed'] &&
        data.allSchools is bool &&
        isValidStringList(data.schools, 50) &&
        isValidPermissionsMap(data.permissions) &&
        data.teacherProfileCompleted is bool &&
        data.teacherPhotoBase64 is string && data.teacherPhotoBase64.size() <= 220000 &&
        isValidStringList(data.requestedSubjects, 30) &&
        isValidStringList(data.requestedClasses, 30) &&
        isValidStringList(data.assignedClassSubjects, 100) &&
        (!('inviteCodeUsed' in data) || (data.inviteCodeUsed is string && data.inviteCodeUsed.size() <= 32)) &&
        isValidTimestamp(data.lastActiveAt) &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidJoinRequest(data, reqUid) {
      return data.keys().hasAll(['uid', 'name', 'email', 'message', 'requestedRole', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'name', 'email', 'message', 'requestedRole', 'status', 'reviewedByUid', 'createdAt', 'updatedAt']) &&
        data.uid == reqUid &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.email is string && data.email.size() <= 160 &&
        data.message is string && data.message.size() <= 400 &&
        data.requestedRole in ['TEACHER', 'OFFICE_OPERATOR', 'OTHER'] &&
        data.status in ['pending', 'approved', 'rejected'] &&
        (!('reviewedByUid' in data) || (data.reviewedByUid is string && data.reviewedByUid.size() <= 128)) &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidInviteCode(data, orgId, codeId) {
      return data.keys().hasAll([
          'code', 'orgId', 'orgName', 'presetRole', 'allSchools', 'schools',
          'permissions', 'createdByUid', 'expiresAt', 'usedByUid', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'code', 'orgId', 'orgName', 'presetRole', 'allSchools', 'schools',
          'permissions', 'createdByUid', 'expiresAt', 'usedByUid', 'usedAt', 'createdAt'
        ]) &&
        data.code == codeId &&
        data.orgId == orgId &&
        data.orgName is string && data.orgName.size() >= 2 && data.orgName.size() <= 120 &&
        data.presetRole in ['ADMIN', 'OFFICE_OPERATOR', 'TEACHER', 'OTHER'] &&
        data.allSchools is bool &&
        isValidStringList(data.schools, 50) &&
        isValidPermissionsMap(data.permissions) &&
        data.createdByUid is string && data.createdByUid.size() >= 1 && data.createdByUid.size() <= 128 &&
        data.expiresAt is timestamp &&
        data.usedByUid is string && data.usedByUid.size() <= 128 &&
        (!('usedAt' in data) || isValidTimestamp(data.usedAt)) &&
        isValidTimestamp(data.createdAt);
    }

    function isValidSchool(data, schoolId) {
      return data.keys().hasAll(['schoolKey', 'name', 'address', 'mobile', 'email', 'logoBase64', 'active', 'classGroups', 'classes', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'schoolKey', 'name', 'address', 'mobile', 'email', 'logoBase64', 'active', 'classGroups', 'classes',
          'printClassTeacherNameOnReports', 'checkReportCardsReadyBeforeBatch', 'openExamsForTeachers', 'classTeacherNamesBySection',
          'autoFillReportAttendance', 'classTeacherAttendanceEditDaysBack',
          'createdAt', 'updatedAt'
        ]) &&
        data.schoolKey == schoolId &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.address is string && data.address.size() <= 300 &&
        data.mobile is string && data.mobile.size() <= 40 &&
        data.email is string && data.email.size() <= 160 &&
        data.logoBase64 is string && data.logoBase64.size() <= 220000 &&
        data.active is bool &&
        data.classGroups is list && data.classGroups.size() <= 30 &&
        data.classes is list && data.classes.size() <= 60 &&
        (!('printClassTeacherNameOnReports' in data) || data.printClassTeacherNameOnReports is bool) &&
        (!('checkReportCardsReadyBeforeBatch' in data) || data.checkReportCardsReadyBeforeBatch is bool) &&
        (!('openExamsForTeachers' in data) || isValidStringList(data.openExamsForTeachers, 4)) &&
        (!('classTeacherNamesBySection' in data) || (data.classTeacherNamesBySection is map && data.classTeacherNamesBySection.size() <= 120)) &&
        (!('autoFillReportAttendance' in data) || data.autoFillReportAttendance is bool) &&
        (!('classTeacherAttendanceEditDaysBack' in data) || (data.classTeacherAttendanceEditDaysBack is int && data.classTeacherAttendanceEditDaysBack >= 0 && data.classTeacherAttendanceEditDaysBack <= 365)) &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidStudent(data, schoolId) {
      return data.keys().hasAll([
          'schoolId', 'classId', 'session', 'admNo', 'name', 'fatherName', 'motherName',
          'dob', 'mobile', 'address', 'photoBase64', 'className', 'section', 'rollNo',
          'sample', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'schoolId', 'classId', 'session', 'admNo', 'name', 'fatherName', 'motherName',
          'dob', 'mobile', 'secondMobile', 'address', 'photoBase64', 'className', 'section', 'rollNo',
          'admissionDate', 'previousSchool', 'siblingGroupId',
          'usesTransport', 'transportRouteId', 'transportRouteName', 'transportStopName', 'transportMonthlyAmount',
          'status', 'leftDate', 'leftReason',
          'sample', 'createdAt', 'updatedAt'
        ]) &&
        data.schoolId == schoolId &&
        data.classId is string && data.classId.size() <= 128 &&
        data.session is string && data.session.size() >= 4 && data.session.size() <= 30 &&
        data.admNo is string && data.admNo.size() >= 1 && data.admNo.size() <= 60 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.fatherName is string && data.fatherName.size() <= 120 &&
        data.motherName is string && data.motherName.size() <= 120 &&
        data.dob is string && data.dob.size() <= 40 &&
        data.mobile is string && data.mobile.size() <= 40 &&
        (!('secondMobile' in data) || (data.secondMobile is string && data.secondMobile.size() <= 40)) &&
        data.address is string && data.address.size() <= 300 &&
        data.photoBase64 is string && data.photoBase64.size() <= 220000 &&
        data.className is string && data.className.size() >= 1 && data.className.size() <= 40 &&
        data.section is string && data.section.size() >= 1 && data.section.size() <= 10 &&
        data.rollNo is int && data.rollNo >= 1 && data.rollNo <= 9999 &&
        (!('admissionDate' in data) || (data.admissionDate is string && data.admissionDate.size() <= 40)) &&
