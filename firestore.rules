    // =========================================================================
    // 1. PRIVATE USER ACCOUNT & 2. ORG CODE RESERVATION
    // =========================================================================
    match /users/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create, update: if isSignedIn() && request.auth.uid == uid && isValidUserAccount(incoming(), uid) && (
        resource == null || (incoming().uid == existing().uid && sameCr() &&
          diffOnly(['name', 'email', 'memberships', 'pendingRequests', 'updatedAt']))
      );
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    match /orgCodes/{code} {
      allow get: if isSignedIn() && isValidOrgCode(code);
      allow list: if false;
      allow create, update: if isSignedIn() && isValidOrgCode(code) && isValidOrgCodeReservation(incoming()) && (
        resource == null
          ? (incoming().ownerUid == request.auth.uid && existsAfter(orgPath(incoming().orgId)) &&
              getAfter(orgPath(incoming().orgId)).data.ownerUid == request.auth.uid &&
              getAfter(orgPath(incoming().orgId)).data.code == code)
          : (existing().ownerUid == request.auth.uid && incoming().orgId == existing().orgId &&
              sameCr() && diffOnly(['name', 'ownerUid']))
      );
      allow delete: if isSignedIn() && isValidOrgCode(code) && existing().ownerUid == request.auth.uid;
    }

    // =========================================================================
    // 3. ORGANISATIONS & MULTI-TENANT SUBCOLLECTIONS
    // =========================================================================
    match /organisations/{orgId} {
      allow get: if okId(orgId) && isActiveMember(orgId);
      allow list: if false;

      allow create, update: if okId(orgId) && isValidOrganisation(incoming()) && (
        resource == null
          ? (!('subscription' in incoming()) && incoming().ownerUid == request.auth.uid &&
              existsAfter(/databases/$(database)/documents/orgCodes/$(incoming().code)) &&
              existsAfter(memberPath(orgId, request.auth.uid)) &&
              getAfter(memberPath(orgId, request.auth.uid)).data.role == 'OWNER' &&
              getAfter(memberPath(orgId, request.auth.uid)).data.status == 'active')
          : (!incoming().diff(existing()).affectedKeys().hasAny(['subscription']) &&
              incoming().code == existing().code && sameCr() && (
                ((isOrgAdmin(orgId) || hasModuleEdit(orgId, 'settings')) && incoming().ownerUid == existing().ownerUid &&
                  diffOnly(['name', 'contactMobile', 'contactEmail', 'settings', 'updatedAt'])) ||
                (hasModuleEdit(orgId, 'sessionPromotion') && incoming().ownerUid == existing().ownerUid &&
                  diffOnly(['settings', 'updatedAt']) &&
                  incoming().settings.passPercent == existing().settings.passPercent &&
                  incoming().settings.showPhotoAndAdmOnAnnual == existing().settings.showPhotoAndAdmOnAnnual &&
                  incoming().settings.showClassRank == existing().settings.showClassRank &&
                  incoming().settings.lastBackupEpochMs == existing().settings.lastBackupEpochMs) ||
                (existing().ownerUid == request.auth.uid && isOrgOwner(orgId) &&
                  exists(memberPath(orgId, incoming().ownerUid)) && get(memberPath(orgId, incoming().ownerUid)).data.status == 'active' &&
                  diffOnly(['ownerUid', 'updatedAt']))
              ))
      );

      allow delete: if okId(orgId) && existing().ownerUid == request.auth.uid && isOrgOwner(orgId);

      match /members/{memberUid} {
        allow get: if okId(memberUid) && (request.auth.uid == memberUid || hasModuleView(orgId, 'members'));
        allow list: if isSignedIn() && hasModuleView(orgId, 'members');
        allow create: if okId(memberUid) && isValidMember(incoming(), memberUid) &&
          !('adFreeUntil' in incoming()) && !('adsWatchedWindow' in incoming()) && (
            (request.auth.uid == memberUid && incoming().role == 'OWNER' && incoming().status == 'active' &&
              incoming().allSchools == true && existsAfter(orgPath(orgId)) && getAfter(orgPath(orgId)).data.ownerUid == request.auth.uid) ||
            (hasModuleEdit(orgId, 'members') && incoming().role != 'OWNER' && incoming().status == 'active' &&
              salaryPrivilegeNoneOrOwner(orgId, incoming().permissions)) ||
            canInviteRedeemCreate(orgId, memberUid, incoming())
          );
        allow update: if okId(memberUid) && (
          (request.auth.uid == memberUid && isSelfRewardedAdFreeUpdate(memberUid)) || (
            !incoming().diff(existing()).affectedKeys().hasAny(['adFreeUntil', 'adsWatchedWindow']) &&
            incoming().uid == existing().uid && sameCr() &&
            canUpdateMember(orgId, memberUid) && isValidMember(incoming(), memberUid)
          )
        );
        allow delete: if okId(memberUid) && (
          (existing().role == 'OWNER' && isOrgOwner(orgId) && !existsAfter(orgPath(orgId))) ||
          (request.auth.uid == memberUid && existing().role != 'OWNER') ||
          (isOrgAdmin(orgId) && existing().role != 'OWNER')
        );
      }

      match /joinRequests/{reqUid} {
        allow get: if okId(reqUid) && (request.auth.uid == reqUid || hasModuleView(orgId, 'members'));
        allow list: if isSignedIn() && hasModuleView(orgId, 'members');
        allow create, update: if okId(reqUid) && isValidJoinRequest(incoming(), reqUid) && (
          resource == null
            ? (request.auth.uid == reqUid && incoming().status == 'pending' && exists(orgPath(orgId)))
            : (incoming().uid == existing().uid && sameCr() && (
                (hasModuleEdit(orgId, 'members') && existing().status == 'pending' && incoming().status in ['approved', 'rejected'] &&
                  diffOnly(['status', 'reviewedByUid', 'updatedAt'])) ||
                (request.auth.uid == reqUid && existing().status in ['pending', 'rejected'] && incoming().status == 'pending' &&
                  diffOnly(['name', 'message', 'requestedRole', 'status', 'updatedAt']))
              ))
        );
        allow delete: if okId(reqUid) && (request.auth.uid == reqUid || hasModuleEdit(orgId, 'members'));
      }

      match /inviteCodes/{inviteCode} {
        allow get: if okId(inviteCode);
        allow list: if isSignedIn() && hasModuleView(orgId, 'members');
        allow create, update: if okId(inviteCode) && isValidInviteCode(incoming(), orgId, inviteCode) && (
          resource == null
            ? (isOrgAdmin(orgId) && salaryPrivilegeNoneOrOwner(orgId, incoming().permissions) &&
                incoming().createdByUid == request.auth.uid && incoming().usedByUid == '' && incoming().expiresAt > request.time)
            : (existing().usedByUid == '' && existing().expiresAt > request.time &&
                incoming().usedByUid == request.auth.uid && sameCr() &&
                diffOnly(['usedByUid', 'usedAt']) && existsAfter(memberPath(orgId, request.auth.uid)))
        );
        allow delete: if okId(inviteCode) && isOrgAdmin(orgId);
      }

      match /auditLog/{entryId} {
        allow get, list: if isSignedIn() && isOrgAdmin(orgId);
        allow create: if okId(entryId) && isValidAuditEntry(incoming()) &&
          (isActiveMember(orgId) || (existsAfter(orgPath(orgId)) && getAfter(orgPath(orgId)).data.ownerUid == request.auth.uid));
        allow update: if false;
        allow delete: if isOrgTeardown(orgId);
      }

      match /deletedUsers/{deletedUid} {
        allow get, list: if isSignedIn() && isActiveMember(orgId);
        allow create: if okId(deletedUid) && request.auth.uid == deletedUid && isActiveMember(orgId) &&
          incoming().keys().hasOnly(['uid', 'deletedAt']) && incoming().uid == deletedUid && isValidTimestamp(incoming().deletedAt);
        allow update: if false;
        allow delete: if isOrgTeardown(orgId);
      }

      match /schools/{schoolId} {
        allow get: if okId(schoolId) && canAccessSchool(orgId, schoolId);
        allow list: if isSignedIn() && (isOrgAdmin(orgId) || (isActiveMember(orgId) && memberData(orgId).allSchools == true));
        allow create, update: if okId(schoolId) && isValidSchool(incoming(), schoolId) && (
          resource == null
            ? ((existsAfter(orgPath(orgId)) && getAfter(orgPath(orgId)).data.ownerUid == request.auth.uid) || hasModuleEdit(orgId, 'settings'))
            : (incoming().schoolKey == existing().schoolKey && sameCr() &&
                canAccessSchool(orgId, schoolId) && (
                  (hasModuleEdit(orgId, 'settings') && diffOnly([
                    'name', 'address', 'mobile', 'email', 'logoBase64', 'active', 'classGroups', 'classes',
                    'printClassTeacherNameOnReports', 'checkReportCardsReadyBeforeBatch', 'openExamsForTeachers',
                    'classTeacherNamesBySection', 'autoFillReportAttendance', 'classTeacherAttendanceEditDaysBack', 'updatedAt'
                  ])) ||
                  (hasModuleEdit(orgId, 'teachers') && diffOnly(['classTeacherNamesBySection', 'updatedAt']))
                ))
        );
        allow delete: if okId(schoolId) && isOrgAdmin(orgId);

        match /students/{studentId} {
          allow get, list: if isSignedIn() && canReadStudents(orgId, schoolId);
          allow create, update: if okId(studentId) && (
            resource == null
              ? (canAccessSchool(orgId, schoolId) && (hasModuleEdit2(orgId, 'students', 'studentRegister') || hasModuleEdit2(orgId, 'enquiry', 'sessionPromotion')))
              : (sameSchCr() && canUpdateStudent(orgId, schoolId))
          ) && isValidStudent(incoming(), schoolId);
          allow delete: if okId(studentId) && canAccessSchool(orgId, schoolId) &&
            hasModuleEdit3(orgId, 'students', 'studentRegister', 'sessionPromotion');
        }

        match /marks/{markId} {
          allow get: if isSignedIn() && canGetMark(orgId, schoolId, resource.data);
          allow list: if isSignedIn() && canListMarks(orgId, schoolId);
          allow create, update: if okId(markId) && isValidMark(incoming(), schoolId) &&
            canEditMarkScope(orgId, schoolId, incoming().studentId, incoming().className, incoming().subjectName, incoming().componentKey) && (
              resource == null || (
                sameStu() && sameSchCr() &&
                incoming().subjectName == existing().subjectName && incoming().componentKey == existing().componentKey &&
                diffOnly(['className', 'rawValue', 'updatedByUid', 'updatedByName', 'clientEditedAtMs', 'updatedAt'])
              )
            );
          allow delete: if okId(markId) && canEditMarkScope(orgId, schoolId, existing().studentId, existing().className, existing().subjectName, existing().componentKey);
        }

        match /markEditLogs/{logId} {
          allow get, list: if isSignedIn() && canAccessSchool(orgId, schoolId) && hasModuleView(orgId, 'marks');
          allow create: if okId(logId) && isValidMarkEditLog(incoming(), schoolId) &&
            canEditMarkScope(orgId, schoolId, incoming().studentId, incoming().className, incoming().subjectName, incoming().componentKey);
          allow update: if false;
          allow delete: if isOrgTeardown(orgId);
        }

        match /coScholastic/{coId} {
          allow get, list: if isSignedIn() && canAccessSchool(orgId, schoolId) && hasModuleView2(orgId, 'coScholastic', 'reports');
          allow create, update: if okId(coId) && isValidCoScholastic(incoming(), schoolId) && canEditCoScholasticScope(orgId, schoolId, incoming().studentId) && (
            resource == null || (
              sameStu() && sameSchCr() && incoming().termNo == existing().termNo && incoming().areaCode == existing().areaCode &&
              diffOnly(['grade', 'updatedByUid', 'updatedAt'])
            )
          );
          allow delete: if okId(coId) && canEditCoScholasticScope(orgId, schoolId, existing().studentId);
        }

        match /termInfo/{termInfoId} {
          allow get, list: if isSignedIn() && canAccessSchool(orgId, schoolId) && (
            hasModuleView3(orgId, 'coScholastic', 'reports', 'attendance') || hasAnyClassTeacherSection(orgId)
          );
          allow create, update: if okId(termInfoId) && isValidTermInfo(incoming(), schoolId) && (
            resource == null
              ? (canEditCoScholasticScope(orgId, schoolId, incoming().studentId) || (
                  canRecalculateTermAttendance(orgId, schoolId, incoming().studentId) &&
                  incoming().remarks == '' && incoming().promotedTo == '' && incoming().reportDate == ''
                ))
              : (sameStu() && sameSchCr() && incoming().termNo == existing().termNo && (
                  (canEditCoScholasticScope(orgId, schoolId, incoming().studentId) &&
                    diffOnly(['daysPresent', 'workingDays', 'remarks', 'promotedTo', 'reportDate', 'attendanceManualOverride', 'updatedByUid', 'updatedAt'])) ||
                  (canRecalculateTermAttendance(orgId, schoolId, incoming().studentId) &&
                    diffOnly(['daysPresent', 'workingDays', 'attendanceManualOverride', 'updatedByUid', 'updatedAt']))
                ))
          );
          allow delete: if okId(termInfoId) && canEditCoScholasticScope(orgId, schoolId, existing().studentId);
        }
      }

      match /teachers/{teacherId} {
        allow get, list: if isSignedIn() && (
          hasModuleView3(orgId, 'teachers', 'exams', 'resultAnalysis') ||
          hasModuleView(orgId, 'classDiary') || hasModuleEdit(orgId, 'timetable') || hasSalaryView(orgId) ||
          (hasModuleView2(orgId, 'timetable', 'marks') && resource.data.linkedMemberUid == request.auth.uid)
        );
        allow create, update: if okId(teacherId) && isValidTeacher(incoming()) && (
          resource == null
            ? (hasModuleEdit(orgId, 'teachers') || (isActiveMember(orgId) && memberData(orgId).role == 'TEACHER' &&
                teacherId == ('tchr_member_' + request.auth.uid) && incoming().linkedMemberUid == request.auth.uid))
            : (sameCr() && (
                hasModuleEdit(orgId, 'teachers') || (isActiveMember(orgId) && memberData(orgId).role == 'TEACHER' &&
                  teacherId == ('tchr_member_' + request.auth.uid) && existing().linkedMemberUid == request.auth.uid &&
                  incoming().linkedMemberUid == request.auth.uid &&
                  diffOnly(['name', 'mobile', 'photoBase64', 'subjects', 'updatedAt']))
              ))
        );
        allow delete: if okId(teacherId) && hasModuleEdit(orgId, 'teachers');
      }

      match /periodStructures/{schoolId} {
        allow get, list: if isSignedIn() && (hasModuleView(orgId, 'teachers') || hasModuleEdit(orgId, 'timetable'));
        allow create, update: if okId(schoolId) && isValidPeriodStructure(incoming(), schoolId) && canModSchoolWrite(orgId, 'teachers', schoolId) && (resource == null || sameSchCr());
        allow delete: if okId(schoolId) && canModSchoolWrite(orgId, 'teachers', schoolId);
      }

      match /classAssignments/{assignmentId} {
        allow get, list: if isSignedIn() && (hasModuleView3(orgId, 'teachers', 'resultAnalysis', 'classDiary') || hasModuleEdit(orgId, 'timetable'));
        allow create, update: if okId(assignmentId) && isValidClassAssignment(incoming()) && canModSchoolWrite(orgId, 'teachers', incoming().schoolId) && (resource == null || sameSchCr());
        allow delete: if okId(assignmentId) && canModSchoolWrite(orgId, 'teachers', existing().schoolId);
      }

      match /subjectRules/{ruleId} {
        allow get, list: if isSignedIn() && (hasModuleView(orgId, 'teachers') || hasModuleEdit(orgId, 'timetable'));
        allow create, update: if okId(ruleId) && isValidSubjectRule(incoming()) && canModSchoolWrite(orgId, 'teachers', incoming().schoolId) &&
          (resource == null || (sameSchCr() && incoming().subjectName == existing().subjectName));
        allow delete: if okId(ruleId) && canModSchoolWrite(orgId, 'teachers', existing().schoolId);
      }

      match /timetableCells/{cellId} {
        allow get, list: if isSignedIn() && hasModuleView(orgId, 'timetable');
        allow create, update: if okId(cellId) && isValidTimetableCell(incoming()) && canModSchoolWrite(orgId, 'timetable', incoming().schoolId) && (
          resource == null || (sameSchSesCr() && incoming().className == existing().className &&
            incoming().section == existing().section && incoming().day == existing().day && incoming().slotId == existing().slotId)
        );
        allow delete: if okId(cellId) && canModSchoolWrite(orgId, 'timetable', existing().schoolId);
      }

      match /timetableLayouts/{schoolId} {
        allow get, list: if isSignedIn() && hasModuleView(orgId, 'timetable');
        allow create, update: if okId(schoolId) && isValidPeriodStructure(incoming(), schoolId) &&
          hasModuleEdit2(orgId, 'teachers', 'timetable') && canAccessSchool(orgId, schoolId) && (resource == null || sameSchCr());
        allow delete: if okId(schoolId) && hasModuleEdit2(orgId, 'teachers', 'timetable') && canAccessSchool(orgId, schoolId);
      }

      match /teacherLeaves/{leaveId} {
        allow get, list: if isSignedIn() && (hasModuleView2(orgId, 'timetable', 'exams') || hasSalaryView(orgId));
        allow create, update: if okId(leaveId) && isValidTeacherLeave(incoming()) && (
          resource == null
            ? (hasModuleEdit(orgId, 'timetable') || (hasModuleView(orgId, 'timetable') && incoming().status == 'PENDING' &&
                incoming().requestedByUid == request.auth.uid && incoming().approvedByUid == '' && incoming().approvedAtMs == 0 &&
                exists(teacherDocPath(orgId, incoming().teacherId)) && get(teacherDocPath(orgId, incoming().teacherId)).data.linkedMemberUid == request.auth.uid))
            : (incoming().teacherId == existing().teacherId && incoming().requestedByUid == existing().requestedByUid &&
                sameCr() && (
                  hasModuleEdit(orgId, 'timetable') || (hasModuleView(orgId, 'timetable') && existing().requestedByUid == request.auth.uid &&
                    existing().status == 'PENDING' && incoming().status in ['PENDING', 'CANCELLED'] &&
                    incoming().approvedByUid == '' && incoming().approvedAtMs == 0)
                ))
        );
        allow delete: if okId(leaveId) && hasModuleEdit(orgId, 'timetable');
      }

      match /substitutions/{subId} {
        allow get, list: if isSignedIn() && hasModuleView(orgId, 'timetable');
        allow create, update: if okId(subId) && isValidSubstitution(incoming()) && canModSchoolWrite(orgId, 'timetable', incoming().schoolId) && (
          resource == null || (sameSchSesCr() && incoming().date == existing().date &&
            incoming().className == existing().className && incoming().section == existing().section && incoming().slotId == existing().slotId)
        );
        allow delete: if okId(subId) && canModSchoolWrite(orgId, 'timetable', existing().schoolId);
      }

      match /timetableUndoSnapshots/{snapId} {
        allow get, list: if isSignedIn() && hasModuleEdit(orgId, 'timetable');
        allow create, update: if okId(snapId) && isValidTimetableUndoSnapshot(incoming()) && canModSchoolWrite(orgId, 'timetable', incoming().schoolId);
        allow delete: if okId(snapId) && canModSchoolWrite(orgId, 'timetable', existing().schoolId);
      }

      match /teacherScopes/{memberUid} {
        allow get: if okId(memberUid) && (
          (request.auth.uid == memberUid && isActiveMember(orgId)) || hasModuleView(orgId, 'teachers') ||
          (isActiveMember(orgId) && memberData(orgId).role != 'TEACHER' && hasModuleView2(orgId, 'marks', 'reports'))
        );
        allow list: if isSignedIn() && (
          hasModuleView(orgId, 'teachers') ||
          (isActiveMember(orgId) && memberData(orgId).role != 'TEACHER' && hasModuleView2(orgId, 'marks', 'reports'))
        );
        allow create, update: if okId(memberUid) && isValidTeacherScope(incoming(), memberUid) && hasModuleEdit2(orgId, 'teachers', 'members');
        allow delete: if okId(memberUid) && (hasModuleEdit2(orgId, 'teachers', 'members') || (request.auth.uid == memberUid && !existsAfter(memberPath(orgId, memberUid))));
      }

      match /teacherAttendance/{attId} {
        allow get, list: if isSignedIn() && (hasModuleView(orgId, 'timetable') || hasSalaryView(orgId));
        allow create, update: if okId(attId) && isValidTeacherAttendance(incoming()) && canModSchoolWrite(orgId, 'timetable', incoming().schoolId) &&
          (resource == null || (sameSchCr() && incoming().date == existing().date && incoming().teacherId == existing().teacherId));
        allow delete: if okId(attId) && canModSchoolWrite(orgId, 'timetable', existing().schoolId);
      }

      match /schoolCalendars/{calId} {
        allow get, list: if isSignedIn() && isActiveMember(orgId) && (
          hasModuleView5(orgId, 'attendance', 'reports', 'coScholastic', 'settings', 'sessionPromotion') || hasAnyClassTeacherSection(orgId)
        );
        allow create, update: if okId(calId) && isValidSchoolCalendar(incoming()) && canEditSchoolCalendar(orgId, incoming().schoolId) &&
          (resource == null || sameSchSesCr());
        allow delete: if okId(calId) && isOrgAdmin(orgId);
      }

      match /studentAttendance/{attId} {
        allow get: if isSignedIn() && isActiveMember(orgId) && canAccessSchool(orgId, resource.data.schoolId) && (
          hasModuleView3(orgId, 'attendance', 'reports', 'coScholastic') ||
          isClassTeacherOfSection(orgId, resource.data.schoolId, resource.data.className, resource.data.section)
        );
        allow list: if isSignedIn() && isActiveMember(orgId) && (
          hasModuleView(orgId, 'attendance') ||
          (canAccessSchool(orgId, resource.data.schoolId) && isClassTeacherOfSection(orgId, resource.data.schoolId, resource.data.className, resource.data.section))
        );
        allow create, update: if okId(attId) && isValidStudentAttendance(incoming()) &&
          canEditStudentAttendance(orgId, incoming().schoolId, incoming().className, incoming().section, incoming().dateEpochDay) && (
            resource == null || (sameSchSesCr() && incoming().className == existing().className &&
              incoming().section == existing().section && incoming().date == existing().date &&
              incoming().dateEpochDay == existing().dateEpochDay &&
              diffOnly([
                'entries', 'presentCount', 'absentCount', 'leaveCount', 'lateCount', 'halfDayCount', 'totalStudents',
                'updatedByUid', 'updatedByName', 'clientEditedAtMs', 'updatedAt'
              ]))
          );
        allow delete: if okId(attId) && isOrgAdmin(orgId);
      }

      match /studentAttendanceEditLogs/{logId} {
        allow get: if isSignedIn() && isActiveMember(orgId) && canAccessSchool(orgId, resource.data.schoolId) && (
          hasModuleView(orgId, 'attendance') ||
          isClassTeacherOfSection(orgId, resource.data.schoolId, resource.data.className, resource.data.section)
        );
        allow list: if isSignedIn() && isActiveMember(orgId) && (
          hasModuleView(orgId, 'attendance') ||
          (canAccessSchool(orgId, resource.data.schoolId) && isClassTeacherOfSection(orgId, resource.data.schoolId, resource.data.className, resource.data.section))
        );
        allow create: if okId(logId) && isValidStudentAttendanceEditLog(incoming()) && (
          isOrgAdmin(orgId) || (canAccessSchool(orgId, incoming().schoolId) && (
            hasModuleEdit(orgId, 'attendance') || isClassTeacherOfSection(orgId, incoming().schoolId, incoming().className, incoming().section)
          ))
        );
        allow update: if false;
        allow delete: if isOrgTeardown(orgId);
      }

      match /feeStructures/{structureId} {
        allow get, list: if isSignedIn() && hasModuleView5(orgId, 'fees', 'stock', 'exams', 'transport', 'sessionPromotion');
        allow create, update: if okId(structureId) && isValidFeeStructure(incoming()) && canAccessSchool(orgId, incoming().schoolId) && (
          resource == null
            ? hasModuleEdit3(orgId, 'fees', 'stock', 'sessionPromotion')
            : (sameSchSesCr() && (hasModuleEdit(orgId, 'fees') || (hasModuleEdit(orgId, 'stock') &&
                diffOnly(['optionalCatalogue', 'updatedByUid', 'updatedByName', 'clientEditedAtMs', 'updatedAt']))))
        );
        allow delete: if okId(structureId) && isOrgAdmin(orgId);
      }

      match /studentFeeOverrides/{overrideId} {
        allow get, list: if isSignedIn() && hasModuleView3(orgId, 'fees', 'exams', 'sessionPromotion');
        allow create, update: if okId(overrideId) && isValidStudentFeeOverride(incoming()) &&
          hasModuleEdit2(orgId, 'fees', 'sessionPromotion') && canAccessSchool(orgId, incoming().schoolId) &&
          (resource == null || (sameSchSesCr() && sameStu()));
        allow delete: if okId(overrideId) && hasModuleEdit2(orgId, 'fees', 'sessionPromotion') && canAccessSchool(orgId, existing().schoolId);
      }

      match /feeReceipts/{receiptId} {
        allow get, list: if isSignedIn() && (hasModuleView5(orgId, 'fees', 'cashBook', 'stock', 'exams', 'transport') || hasModuleView(orgId, 'sessionPromotion'));
        allow create: if okId(receiptId) && isValidFeeReceiptCreate(incoming()) &&
          canModSchoolWrite(orgId, 'fees', incoming().schoolId) && canIssueReceiptWithConcession(orgId, incoming());
        allow update: if okId(receiptId) && canModSchoolWrite(orgId, 'fees', existing().schoolId) && isValidIssuedCancel(incoming(), existing());
        allow delete: if isOrgTeardown(orgId);
      }

      match /feeMessageSentLogs/{logId} {
        allow get, list: if isSignedIn() && hasModuleView(orgId, 'fees');
        allow create, update: if okId(logId) && isValidFeeMessageSentLog(incoming()) && canModSchoolWrite(orgId, 'fees', incoming().schoolId) &&
          (resource == null || (sameSchSesCr() && sameStu()));
        allow delete: if okId(logId) && isOrgAdmin(orgId);
      }

      match /schoolNotices/{noticeId} {
        allow get, list: if isSignedIn() && hasModuleView(orgId, 'fees');
        allow create, update: if okId(noticeId) && isValidSchoolNotice(incoming()) && canModSchoolWrite(orgId, 'fees', incoming().schoolId) &&
          (resource == null || sameSchCr());
        allow delete: if okId(noticeId) && canModSchoolWrite(orgId, 'fees', existing().schoolId);
      }

      match /schoolCertificates/{certId} {
        allow get, list: if isSignedIn() && hasModuleView(orgId, 'certificates');
        allow create: if okId(certId) && isValidSchoolCertificateCreate(incoming()) && canModSchoolWrite(orgId, 'certificates', incoming().schoolId);
        allow update: if okId(certId) && canModSchoolWrite(orgId, 'certificates', existing().schoolId) && isValidIssuedCancel(incoming(), existing());
        allow delete: if isOrgTeardown(orgId);
      }

      match /cashBookSettings/{settingId} {
        allow get, list: if isSignedIn() && hasModuleView(orgId, 'cashBook');
        allow create, update: if okId(settingId) && isValidCashBookSettings(incoming()) && canModSchoolWrite(orgId, 'cashBook', incoming().schoolId) && (
          resource == null
            ? (isOrgAdmin(orgId) || incoming().expenseApprovalLimitRs == 5000)
            : (sameSchCr() && (isOrgAdmin(orgId) || incoming().expenseApprovalLimitRs == existing().expenseApprovalLimitRs))
        );
        allow delete: if isOrgTeardown(orgId);
      }

      match /cashBookEntries/{entryId} {
        allow get, list: if isSignedIn() && (hasModuleView(orgId, 'cashBook') || (hasModuleView(orgId, 'transport') && resource.data.sourceModule == 'TRANSPORT'));
        allow create: if okId(entryId) && isValidCashBookEntryCreate(incoming()) && (
          hasModuleEdit(orgId, 'cashBook') || (hasModuleEdit(orgId, 'transport') && 'sourceModule' in incoming() && incoming().sourceModule == 'TRANSPORT' &&
            incoming().entryType == 'EXPENSE' && 'transportCategory' in incoming() && incoming().transportCategory is string && incoming().transportCategory.size() >= 1)
        ) && canAccessSchool(orgId, incoming().schoolId) && canRecordCashBookExpense(orgId, incoming());
        allow update: if canUpdateCashBookEntry(orgId, entryId);
        allow delete: if isOrgTeardown(orgId);
      }

      match /cashBookDayClosings/{closingId} {
        allow get, list: if isSignedIn() && hasModuleView(orgId, 'cashBook');
        allow create, update: if okId(closingId) && isValidCashBookDayClosing(incoming()) && canModSchoolWrite(orgId, 'cashBook', incoming().schoolId) &&
          (resource == null || (sameSchCr() && incoming().dateIso == existing().dateIso));
        allow delete: if isOrgTeardown(orgId);
      }

      match /cashBookAuditLogs/{logId} {
        allow get, list: if isSignedIn() && (hasModuleView(orgId, 'cashBook') || (hasModuleView(orgId, 'transport') && resource.data.sourceModule == 'TRANSPORT'));
        allow create: if okId(logId) && isValidCashBookAuditLog(incoming()) && (
          hasModuleEdit(orgId, 'cashBook') || (hasModuleEdit(orgId, 'transport') && 'sourceModule' in incoming() && incoming().sourceModule == 'TRANSPORT')
        ) && canAccessSchool(orgId, incoming().schoolId);
        allow update: if false;
        allow delete: if isOrgTeardown(orgId);
      }

      match /enquirySettings/{settingId} {
        allow get, list: if isSignedIn() && hasModuleView(orgId, 'enquiry');
        allow create, update: if okId(settingId) && isValidEnquirySettings(incoming()) && canModSchoolWrite(orgId, 'enquiry', incoming().schoolId) &&
          (resource == null || sameSchCr());
        allow delete: if isOrgTeardown(orgId);
      }

      match /admissionEnquiries/{enquiryId} {
        allow get, list: if isSignedIn() && hasModuleView(orgId, 'enquiry');
        allow create, update: if okId(enquiryId) && isValidAdmissionEnquiry(incoming()) && canModSchoolWrite(orgId, 'enquiry', incoming().schoolId) && (
          resource == null
            ? (incoming().createdByUid == request.auth.uid)
            : (sameSchCr() && incoming().createdByUid == existing().createdByUid)
        );
        allow delete: if okId(enquiryId) && isOrgAdmin(orgId);
      }

      match /examSchedules/{examId} {
        allow get, list: if isSignedIn() && hasModuleView(orgId, 'exams');
        allow create, update: if okId(examId) && isValidExamSchedule(incoming()) && canModSchoolWrite(orgId, 'exams', incoming().schoolId) &&
          (resource == null || incoming().schoolId == existing().schoolId);
        allow delete: if okId(examId) && canModSchoolWrite(orgId, 'exams', existing().schoolId);
      }

      match /examInvigilatorDuties/{dutyId} {
        allow get, list: if isSignedIn() && (hasModuleView(orgId, 'exams') || (isActiveMember(orgId) && resource.data.teacherUid == request.auth.uid));
        allow create, update: if okId(dutyId) && isValidExamInvigilatorDuty(incoming()) && canModSchoolWrite(orgId, 'exams', incoming().schoolId);
        allow delete: if okId(dutyId) && canModSchoolWrite(orgId, 'exams', existing().schoolId);
      }

      match /transportRoutes/{routeId} {
        allow get, list: if isSignedIn() && hasModuleView3(orgId, 'transport', 'studentRegister', 'fees');
        allow create, update: if okId(routeId) && isValidTransportRoute(incoming()) && canModSchoolWrite(orgId, 'transport', incoming().schoolId);
        allow delete: if okId(routeId) && canModSchoolWrite(orgId, 'transport', existing().schoolId);
      }

      match /transportSettings/{settingId} {
        allow get, list: if isSignedIn() && hasModuleView(orgId, 'transport');
        allow create, update: if okId(settingId) && isValidTransportSettings(incoming()) && canModSchoolWrite(orgId, 'transport', incoming().schoolId);
        allow delete: if isOrgTeardown(orgId);
      }

      // Merged identical CRUD collections: examRooms, examSeatings, transportVehicleDocuments
      match /{col}/{docId} {
        allow get, list: if col in ['examRooms', 'examSeatings', 'transportVehicleDocuments'] && isSignedIn() && hasModuleView(orgId, simpleCrudMod(col));
        allow create, update: if col in ['examRooms', 'examSeatings', 'transportVehicleDocuments'] && okId(docId) &&
          isValidSimpleCrudDoc(col, incoming()) && canModSchoolWrite(orgId, simpleCrudMod(col), incoming().schoolId);
        allow delete: if col in ['examRooms', 'examSeatings', 'transportVehicleDocuments'] && okId(docId) &&
          canModSchoolWrite(orgId, simpleCrudMod(col), existing().schoolId);
      }

      // Merged identical append-only teardown logs: feeAuditLogs, stockTransactions
      match /{col}/{docId} {
        allow get, list: if col in ['feeAuditLogs', 'stockTransactions'] && isSignedIn() && hasModuleView(orgId, appendLogMod(col));
        allow create: if col in ['feeAuditLogs', 'stockTransactions'] && okId(docId) &&
          isValidAppendLogDoc(col, incoming()) && canModSchoolWrite(orgId, appendLogMod(col), incoming().schoolId);
        allow update: if col in ['feeAuditLogs', 'stockTransactions'] && false;
        allow delete: if col in ['feeAuditLogs', 'stockTransactions'] && isOrgTeardown(orgId);
      }

      // PHASE 12: STAFF SALARY ('salary')
      match /salaryRuleConfigs/{configId} {
        allow get, list: if isSignedIn() && hasSalaryView(orgId);
        allow create, update: if okId(configId) && isValidSalaryRuleConfig(incoming()) && hasSalaryEdit(orgId) &&
          canAccessSchool(orgId, incoming().schoolId) && (
            resource == null
              ? (incoming().allowTeachersToViewOwnSlips == false || isOrgOwner(orgId))
              : (incoming().schoolId == existing().schoolId && (incoming().allowTeachersToViewOwnSlips == existing().allowTeachersToViewOwnSlips || isOrgOwner(orgId)))
          );
        allow delete: if okId(configId) && isOrgOwner(orgId);
      }

      match /staffSalaryProfiles/{profileId} {
        allow get, list: if isSignedIn() && hasSalaryView(orgId);
        allow create, update: if okId(profileId) && isValidStaffSalaryProfile(incoming()) &&
          hasSalaryEdit(orgId) && (incoming().allSchools == true || canAccessSchool(orgId, incoming().primarySchoolId));
        allow delete: if okId(profileId) && (
          isOrgOwner(orgId) || (hasSalaryEdit(orgId) && (existing().allSchools == true || canAccessSchool(orgId, existing().primarySchoolId)))
        );
      }

      match /salaryMonthlyRecords/{recordId} {
        allow get, list: if isSignedIn() && (
          hasSalaryView(orgId) || (isActiveMember(orgId) && resource.data.staffUid == request.auth.uid && resource.data.teacherSelfViewEnabled == true)
        );
        allow create, update: if okId(recordId) && isValidSalaryMonthlyRecord(incoming()) &&
          hasSalaryEdit(orgId) && canAccessSchool(orgId, incoming().schoolId) && (
            !isSalaryMonthLockedInRules(orgId, incoming().schoolId, incoming().yearMonth) ||
            (incoming().lastLockOverrideReason is string && incoming().lastLockOverrideReason.size() >= 1) ||
            (resource != null && isOrgOwner(orgId) &&
              diffOnly(['teacherSelfViewEnabled', 'updatedByUid', 'updatedByName', 'clientEditedAtMs', 'updatedAt']))
          );
        allow delete: if okId(recordId) && isOrgOwner(orgId);
      }

      match /staffSalaryAdvances/{advanceId} {
        allow get, list: if isSignedIn() && hasSalaryView(orgId);
        allow create, update: if okId(advanceId) && isValidStaffSalaryAdvance(incoming()) &&
          hasSalaryEdit(orgId) && canAccessSchool(orgId, incoming().schoolId);
        allow delete: if okId(advanceId) && isOrgOwner(orgId);
      }

      match /salaryMonthLocks/{lockId} {
        allow get, list: if isSignedIn() && hasSalaryView(orgId);
        allow create, update: if okId(lockId) && isValidSalaryMonthLock(incoming()) &&
          isOrgOwner(orgId) && canAccessSchool(orgId, incoming().schoolId);
        allow delete: if okId(lockId) && isOrgOwner(orgId);
      }

      match /salaryAuditLogs/{logId} {
        allow get, list: if isSignedIn() && hasSalaryView(orgId);
        allow create: if okId(logId) && isValidSalaryAuditLog(incoming()) &&
          hasSalaryEdit(orgId) && canAccessSchool(orgId, incoming().schoolId);
        allow update: if false;
        allow delete: if okId(logId) && isOrgOwner(orgId);
      }

      // PHASE 14: SESSION & PROMOTION, BULK IMPORT, BACKUP EXPORT
      match /schoolClassOrders/{schoolId} {
        allow get, list: if isSignedIn() && hasModuleView(orgId, 'sessionPromotion');
        allow create, update: if okId(schoolId) && isValidSchoolClassOrder(incoming(), schoolId) && canModSchoolWrite(orgId, 'sessionPromotion', schoolId);
        allow delete: if okId(schoolId) && isOrgAdmin(orgId);
      }

      match /sessionTransitions/{transitionId} {
        allow get, list: if isSignedIn() && hasModuleView(orgId, 'sessionPromotion');
        allow create, update: if okId(transitionId) && isValidSessionTransition(incoming()) && canModSchoolWrite(orgId, 'sessionPromotion', incoming().schoolId) && (
          resource == null
            ? (incoming().status in ['IN_PROGRESS', 'COMPLETED'] && incoming().appliedByUid == request.auth.uid)
            : (incoming().schoolId == existing().schoolId && incoming().fromSession == existing().fromSession &&
                incoming().toSession == existing().toSession && (
                  (incoming().status == 'UNDONE' && isOrgOwner(orgId) && incoming().undoneByUid == request.auth.uid) ||
                  incoming().status in ['IN_PROGRESS', 'COMPLETED', 'ROLLED_BACK']
                ))
        );
        allow delete: if okId(transitionId) && isOrgOwner(orgId);
      }

      match /promotionRecords/{recordId} {
        allow get, list: if isSignedIn() && hasModuleView3(orgId, 'sessionPromotion', 'students', 'studentRegister');
        allow create, update: if okId(recordId) && isValidPromotionRecord(incoming()) && canModSchoolWrite(orgId, 'sessionPromotion', incoming().schoolId);
        allow delete: if okId(recordId) && (isOrgOwner(orgId) || canModSchoolWrite(orgId, 'sessionPromotion', existing().schoolId));
      }

      match /{col}/{logId} {
        allow get, list: if col in ['bulkImportLogs', 'backupExportLogs'] && isSignedIn() && isOrgAdmin(orgId);
        allow create: if col in ['bulkImportLogs', 'backupExportLogs'] && okId(logId) && isOrgAdmin(orgId) && (
          (col == 'bulkImportLogs' && isValidBulkImportLog(incoming())) ||
          (col == 'backupExportLogs' && isValidBackupExportLog(incoming()) && (incoming().includedSalaryCsv == false || isOrgOwner(orgId)))
        );
        allow update: if col in ['bulkImportLogs', 'backupExportLogs'] && false;
        allow delete: if col in ['bulkImportLogs', 'backupExportLogs'] && okId(logId) && isOrgOwner(orgId);
      }

      // PHASE 18: CLASS DIARY & BIRTHDAYS
      match /classDiaryEntries/{entryId} {
        allow get, list: if isSignedIn() && canReadClassDiaryForSchool(orgId, resource.data.schoolId);
        allow create, update: if okId(entryId) && isValidClassDiaryEntry(incoming()) && (
          resource == null
            ? (incoming().authorUid == request.auth.uid && incoming().editHistory.size() == 0 &&
                canWriteClassDiaryEntry(orgId, incoming().schoolId, incoming().className, incoming().section, incoming().subjectName))
            : (sameSchSesCr() && incoming().dateIso == existing().dateIso && incoming().className == existing().className &&
                incoming().section == existing().section && incoming().subjectName == existing().subjectName &&
                incoming().authorUid == existing().authorUid && incoming().authorName == existing().authorName &&
                incoming().createdAtMs == existing().createdAtMs && incoming().editHistory.size() >= existing().editHistory.size() && (
                  isOrgAdmin(orgId) || (existing().authorUid == request.auth.uid &&
                    canWriteClassDiaryEntry(orgId, existing().schoolId, existing().className, existing().section, existing().subjectName))
                ))
        );
        allow delete: if okId(entryId) && (
          isOrgAdmin(orgId) || (existing().authorUid == request.auth.uid &&
            canWriteClassDiaryEntry(orgId, existing().schoolId, existing().className, existing().section, existing().subjectName))
        );
      }

      match /classDiaryHistory/{historyId} {
        allow get, list: if isSignedIn() && canReadClassDiaryForSchool(orgId, resource.data.schoolId);
        allow create: if okId(historyId) && isValidClassDiaryHistory(incoming()) &&
          canWriteClassDiaryEntry(orgId, incoming().schoolId, incoming().className, incoming().section, incoming().subjectName);
        allow update: if false;
        allow delete: if okId(historyId) && isOrgOwner(orgId);
      }

      match /schoolBirthdayConfigs/{schoolId} {
        allow get, list: if isSignedIn() && canReadBirthdaysForSchool(orgId, schoolId);
        allow create, update: if okId(schoolId) && isValidSchoolBirthdayConfig(incoming(), schoolId) && canManageBirthdayConfigForSchool(orgId, schoolId);
        allow delete: if okId(schoolId) && isOrgOwner(orgId);
      }

      match /birthdayWishes/{wishId} {
        allow get, list: if isSignedIn() && canReadBirthdaysForSchool(orgId, resource.data.schoolId);
        allow create, update: if okId(wishId) && isValidBirthdayWish(incoming()) && canReadBirthdaysForSchool(orgId, incoming().schoolId);
        allow delete: if okId(wishId) && canReadBirthdaysForSchool(orgId, existing().schoolId);
      }

      // PHASE 19: STUDENT REMARKS, PARENT MEETINGS & GATE
      match /studentRemarks/{remarkId} {
        allow get, list: if isSignedIn() &&
          canReadStudentRemarkForClass(orgId, resource.data.schoolId, resource.data.className, resource.data.section);
        allow create: if okId(remarkId) && isValidStudentRemarkCreate(incoming()) &&
          canWriteStudentRemarkForClass(orgId, incoming().schoolId, incoming().className, incoming().section);
        allow update: if okId(remarkId) && existing().status == 'ACTIVE' &&
          canWriteStudentRemarkForClass(orgId, existing().schoolId, existing().className, existing().section) &&
          isValidTimestamp(incoming().updatedAt) && int0(incoming().updatedAtMs) && (
            (incoming().status == 'CANCELLED' && incoming().cancelledByUid == request.auth.uid &&
              strR(incoming().cancelledByName, 1, 120) && incoming().cancelledAtMs is int && incoming().cancelledAtMs > 0 &&
              strR(incoming().cancelledReason, 3, 500) &&
              diffOnly(['status', 'cancelledReason', 'cancelledByUid', 'cancelledByName', 'cancelledAtMs', 'updatedAtMs', 'updatedAt'])) ||
            (incoming().status == 'ACTIVE' && incoming().followUpCompleted is bool && strM(incoming().followUpCompletedNote, 500) &&
              diffOnly(['followUpCompleted', 'followUpCompletedNote', 'updatedAtMs', 'updatedAt']))
          );
        allow delete: if isOrgTeardown(orgId);
      }

      match /studentRemarkCategories/{schoolId} {
        allow get, list: if isSignedIn() && canReadAnyRemarksInSchool(orgId, schoolId);
        allow create, update: if okId(schoolId) && isValidSchoolRemarkCategoryConfig(incoming(), schoolId) &&
          isOrgAdmin(orgId) && canAccessSchool(orgId, schoolId);
        allow delete: if isOrgTeardown(orgId);
      }

      match /parentMeetings/{meetingId} {
        allow get, list: if isSignedIn() && canReadParentMeetingDoc(orgId, resource.data.schoolId, resource.data.className, resource.data.section);
        allow create, update: if okId(meetingId) && isValidParentMeeting(incoming()) &&
          canWriteParentMeetingDoc(orgId, incoming().schoolId, incoming().className, incoming().section) && (
            resource == null
              ? (incoming().createdByUid == request.auth.uid)
              : (incoming().schoolId == existing().schoolId && incoming().session == existing().session &&
                  incoming().className == existing().className && incoming().section == existing().section &&
                  incoming().createdByUid == existing().createdByUid)
          );
        allow delete: if okId(meetingId) && isOrgAdmin(orgId) && canAccessSchool(orgId, existing().schoolId);
      }

      match /studentAuthorizedPickups/{pickupId} {
        allow get, list: if isSignedIn() && canReadAuthorizedPickups(orgId, resource.data.schoolId);
        allow create, update: if okId(pickupId) && isValidAuthorizedPickup(incoming()) && canWriteAuthorizedPickups(orgId, incoming().schoolId);
        allow delete: if okId(pickupId) && canWriteAuthorizedPickups(orgId, existing().schoolId);
      }

      match /gatePasses/{passId} {
        allow get, list: if isSignedIn() && canReadGateForSchool(orgId, resource.data.schoolId);
        allow create: if okId(passId) && isValidGatePass(incoming()) && canWriteGateForSchool(orgId, incoming().schoolId);
        allow update: if false;
        allow delete: if isOrgTeardown(orgId);
      }

      match /visitorEntries/{visitorId} {
        allow get, list: if isSignedIn() && canReadGateForSchool(orgId, resource.data.schoolId);
        allow create, update: if okId(visitorId) && isValidVisitorEntry(incoming()) && canWriteGateForSchool(orgId, incoming().schoolId) && (
          resource == null
            ? (incoming().recordedByUid == request.auth.uid && incoming().status == 'IN')
            : (incoming().schoolId == existing().schoolId && incoming().dateIso == existing().dateIso &&
                incoming().visitorName == existing().visitorName && incoming().recordedByUid == existing().recordedByUid &&
                incoming().status == 'OUT' && incoming().signedOutByUid == request.auth.uid && incoming().timeOut.size() >= 1)
        );
        allow delete: if isOrgTeardown(orgId);
      }
    }

    // =========================================================================
    // 4. REMOTE ADS CONFIG & 5. SERVER-ONLY BILLING / SSV COLLECTIONS
    // =========================================================================
    match /appConfig/{configId} {
      allow get: if isSignedIn() && configId == 'adsConfig';
      allow list: if false;
      allow create, update: if isAppOwner() && configId == 'adsConfig' && isValidRemoteAdsConfig(incoming());
      allow delete: if isAppOwner() && configId == 'adsConfig';
    }

    match /{col}/{docId} {
      allow read, write: if col in ['subscriptionPurchaseLocks', 'rewardedAdNonces', 'rewardedAdTransactions'] && false;
    }
  }
}
