    function cashBookSettingsPath(orgId, schoolId) {
      return /databases/$(database)/documents/organisations/$(orgId)/cashBookSettings/$('cbset_' + schoolId);
    }

    function cashBookApprovalLimit(orgId, schoolId) {
      let hasCfg = exists(cashBookSettingsPath(orgId, schoolId));
      let cfg = hasCfg ? get(cashBookSettingsPath(orgId, schoolId)).data : {};
      return (hasCfg && 'expenseApprovalLimitRs' in cfg && cfg.expenseApprovalLimitRs is int)
        ? cfg.expenseApprovalLimitRs
        : 5000;
    }

    function canRecordCashBookExpense(orgId, data) {
      let limit = cashBookApprovalLimit(orgId, data.schoolId);
      return data.entryType != 'EXPENSE' ||
        limit <= 0 ||
        data.amount <= limit ||
        isOrgAdmin(orgId) ||
        (
          data.approvedByAdminUid != '' &&
          exists(memberPath(orgId, data.approvedByAdminUid)) &&
          get(memberPath(orgId, data.approvedByAdminUid)).data.status == 'active' &&
          get(memberPath(orgId, data.approvedByAdminUid)).data.role in ['OWNER', 'ADMIN']
        );
    }

    function isValidCashBookSettings(data) {
      return data.keys().hasAll([
          'schoolId', 'expenseCategories', 'otherIncomeCategories',
          'expenseApprovalLimitRs', 'defaultOpeningBalanceRs',
          'updatedByUid', 'updatedByName', 'clientEditedAtMs', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'schoolId', 'expenseCategories', 'otherIncomeCategories',
          'expenseApprovalLimitRs', 'defaultOpeningBalanceRs',
          'updatedByUid', 'updatedByName', 'clientEditedAtMs', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.schoolId) &&
        isValidStringList(data.expenseCategories, 40) && data.expenseCategories.size() >= 1 &&
        isValidStringList(data.otherIncomeCategories, 30) && data.otherIncomeCategories.size() >= 1 &&
        data.expenseApprovalLimitRs is int && data.expenseApprovalLimitRs >= 0 && data.expenseApprovalLimitRs <= 10000000 &&
        data.defaultOpeningBalanceRs is int && data.defaultOpeningBalanceRs >= -10000000 && data.defaultOpeningBalanceRs <= 100000000 &&
        data.updatedByUid == request.auth.uid &&
        data.updatedByName is string && data.updatedByName.size() >= 1 && data.updatedByName.size() <= 120 &&
        data.clientEditedAtMs is int && data.clientEditedAtMs >= 0 &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidCashBookEntryCreate(data) {
      return data.keys().hasAll([
          'schoolId', 'dateIso', 'entryType', 'category', 'amount', 'paymentMode', 'note', 'billPhotoBase64',
          'status', 'approvedByAdminUid', 'approvedByAdminName', 'approvalNote',
