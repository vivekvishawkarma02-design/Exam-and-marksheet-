{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Private profile and organisation memberships for a signed-in user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID matching the document ID." },
        "name": { "type": "string", "description": "Display name of the user." },
        "email": { "type": "string", "description": "Email address of the user." },
        "memberships": { "type": "array", "description": "Bounded list (<= 30) of organisations the user belongs to." },
        "pendingRequests": { "type": "array", "description": "Bounded list (<= 20) of pending join requests submitted by the user." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp (FieldValue.serverTimestamp())." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp (FieldValue.serverTimestamp())." }
      },
      "required": ["uid", "name", "email", "memberships", "pendingRequests", "createdAt", "updatedAt"]
    },
    "OrgCodeReservation": {
      "title": "OrgCodeReservation",
      "description": "Exact-lookup reservation mapping a unique lowercase organisation code to its orgId and public display name only.",
      "type": "object",
      "properties": {
        "orgId": { "type": "string" },
        "name": { "type": "string" },
        "ownerUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orgId", "name", "ownerUid", "createdAt"]
    },
    "Organisation": {
      "title": "Organisation",
      "description": "Multi-tenant organisation holding one or more schools, members, settings, and audit logs.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "code": { "type": "string" },
        "ownerUid": { "type": "string" },
        "contactMobile": { "type": "string" },
        "contactEmail": { "type": "string" },
        "settings": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "code", "ownerUid", "contactMobile", "contactEmail", "settings", "createdAt", "updatedAt"]
    },
    "OrgMember": {
      "title": "OrgMember",
      "description": "Member record with role, allowed schools, 8-module permissions, teacher profile fields, and activity timestamp.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "mobile": { "type": "string" },
        "role": { "type": "string", "enum": ["OWNER", "ADMIN", "OFFICE_OPERATOR", "TEACHER", "OTHER"] },
        "status": { "type": "string", "enum": ["active", "removed"] },
        "allSchools": { "type": "boolean" },
        "schools": { "type": "array" },
        "permissions": { "type": "object" },
        "teacherProfileCompleted": { "type": "boolean" },
        "teacherPhotoBase64": { "type": "string" },
        "requestedSubjects": { "type": "array" },
        "requestedClasses": { "type": "array" },
        "assignedClassSubjects": { "type": "array" },
        "inviteCodeUsed": { "type": "string" },
        "lastActiveAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "email", "mobile", "role", "status", "allSchools", "schools", "permissions", "teacherProfileCompleted", "teacherPhotoBase64", "requestedSubjects", "requestedClasses", "assignedClassSubjects", "lastActiveAt", "createdAt", "updatedAt"]
    },
    "JoinRequest": {
      "title": "JoinRequest",
      "description": "Pending membership request created by a signed-in user knowing only the organisation code.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "message": { "type": "string" },
        "requestedRole": { "type": "string", "enum": ["TEACHER", "OFFICE_OPERATOR", "OTHER"] },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "reviewedByUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "email", "message", "requestedRole", "status", "createdAt", "updatedAt"]
    },
    "InviteCode": {
      "title": "InviteCode",
      "description": "One-time expiring invite code with preset role and access created by an organisation admin.",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "orgId": { "type": "string" },
        "orgName": { "type": "string" },
        "presetRole": { "type": "string", "enum": ["ADMIN", "OFFICE_OPERATOR", "TEACHER", "OTHER"] },
        "allSchools": { "type": "boolean" },
        "schools": { "type": "array" },
        "permissions": { "type": "object" },
        "createdByUid": { "type": "string" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "usedByUid": { "type": "string" },
        "usedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "orgId", "orgName", "presetRole", "allSchools", "schools", "permissions", "createdByUid", "expiresAt", "usedByUid", "createdAt"]
    },
    "School": {
      "title": "School",
      "description": "School profile inside an organisation including logo (<150 KB), class groups, subjects, and classes.",
      "type": "object",
      "properties": {
        "schoolKey": { "type": "string" },
        "name": { "type": "string" },
        "address": { "type": "string" },
        "mobile": { "type": "string" },
        "email": { "type": "string" },
        "logoBase64": { "type": "string" },
        "active": { "type": "boolean" },
        "classGroups": { "type": "array" },
        "classes": { "type": "array" },
        "printClassTeacherNameOnReports": { "type": "boolean" },
        "checkReportCardsReadyBeforeBatch": { "type": "boolean" },
        "openExamsForTeachers": { "type": "array" },
        "classTeacherNamesBySection": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["schoolKey", "name", "address", "mobile", "email", "logoBase64", "active", "classGroups", "classes", "createdAt", "updatedAt"]
    },
    "Student": {
      "title": "Student",
      "description": "Student record scoped to a single school within an organisation.",
      "type": "object",
      "properties": {
        "schoolId": { "type": "string" },
        "classId": { "type": "string" },
        "session": { "type": "string" },
        "admNo": { "type": "string" },
        "name": { "type": "string" },
        "fatherName": { "type": "string" },
        "motherName": { "type": "string" },
        "dob": { "type": "string" },
        "mobile": { "type": "string" },
        "address": { "type": "string" },
        "photoBase64": { "type": "string" },
        "className": { "type": "string" },
        "section": { "type": "string" },
        "rollNo": { "type": "integer" },
        "sample": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["schoolId", "classId", "session", "admNo", "name", "fatherName", "motherName", "dob", "mobile", "address", "photoBase64", "className", "section", "rollNo", "sample", "createdAt", "updatedAt"]
    },
    "Mark": {
      "title": "Mark",
      "description": "Subject exam component mark for a student within a school.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "schoolId": { "type": "string" },
        "className": { "type": "string" },
        "subjectName": { "type": "string" },
        "componentKey": { "type": "string" },
        "rawValue": { "type": "string" },
        "updatedByUid": { "type": "string" },
        "updatedByName": { "type": "string" },
        "clientEditedAtMs": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentId", "schoolId", "className", "subjectName", "componentKey", "rawValue", "updatedByUid", "createdAt", "updatedAt"]
    },
    "MarkEditLog": {
      "title": "MarkEditLog",
      "description": "Append-only edit history entry per mark change recording who changed what, when, old value, and new value.",
      "type": "object",
      "properties": {
        "markDocId": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "schoolId": { "type": "string" },
        "className": { "type": "string" },
        "subjectName": { "type": "string" },
        "componentKey": { "type": "string" },
        "oldValue": { "type": "string" },
        "newValue": { "type": "string" },
        "editorUid": { "type": "string" },
        "editorName": { "type": "string" },
        "clientEditedAtMs": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["markDocId", "studentId", "studentName", "schoolId", "className", "subjectName", "componentKey", "oldValue", "newValue", "editorUid", "editorName", "clientEditedAtMs", "createdAt"]
    },
    "CoScholastic": {
      "title": "CoScholastic",
      "description": "Co-scholastic area grade for a student and term.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "schoolId": { "type": "string" },
        "termNo": { "type": "integer" },
        "areaCode": { "type": "string" },
        "grade": { "type": "string" },
        "updatedByUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentId", "schoolId", "termNo", "areaCode", "grade", "updatedByUid", "createdAt", "updatedAt"]
    },
    "TermInfo": {
      "title": "TermInfo",
      "description": "Attendance, remarks, promotion, and report date per student and term.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "schoolId": { "type": "string" },
        "termNo": { "type": "integer" },
        "daysPresent": { "type": "integer" },
        "workingDays": { "type": "integer" },
        "remarks": { "type": "string" },
        "promotedTo": { "type": "string" },
        "reportDate": { "type": "string" },
        "updatedByUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentId", "schoolId", "termNo", "daysPresent", "workingDays", "remarks", "promotedTo", "reportDate", "updatedByUid", "createdAt", "updatedAt"]
    },
    "AuditLogEntry": {
      "title": "AuditLogEntry",
      "description": "Append-only audit trail recording who changed marks, students, members, or access and when.",
      "type": "object",
      "properties": {
        "actorUid": { "type": "string" },
        "actorName": { "type": "string" },
        "action": { "type": "string" },
        "targetType": { "type": "string" },
        "targetId": { "type": "string" },
        "summary": { "type": "string" },
        "schoolId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["actorUid", "actorName", "action", "targetType", "targetId", "summary", "createdAt"]
    },
    "Teacher": {
      "title": "Teacher",
      "description": "Organisation-level teacher profile (either synced from an approved teacher member or created without a login for timetable setup) supporting multiple schools.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "mobile": { "type": "string" },
        "email": { "type": "string" },
        "photoBase64": { "type": "string" },
        "subjects": { "type": "array" },
        "schoolIds": { "type": "array" },
        "maxPeriodsPerDay": { "type": "integer" },
        "maxConsecutivePeriods": { "type": "integer" },
        "weeklyOffDays": { "type": "array" },
        "active": { "type": "boolean" },
        "linkedMemberUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "mobile", "email", "photoBase64", "subjects", "schoolIds", "maxPeriodsPerDay", "maxConsecutivePeriods", "weeklyOffDays", "active", "linkedMemberUid", "createdAt", "updatedAt"]
    },
    "PeriodStructure": {
      "title": "PeriodStructure",
      "description": "Per-school editable working days and ordered daily time slots (periods, assembly, short break, lunch).",
      "type": "object",
      "properties": {
        "schoolId": { "type": "string" },
        "workingDays": { "type": "array" },
        "slotsByDay": { "type": "object" },
        "updatedByUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["schoolId", "workingDays", "slotsByDay", "updatedByUid", "createdAt", "updatedAt"]
    },
    "ClassAssignment": {
      "title": "ClassAssignment",
      "description": "Class-section class teacher and per-subject teacher + periods-per-week assignment.",
      "type": "object",
      "properties": {
        "schoolId": { "type": "string" },
        "className": { "type": "string" },
        "section": { "type": "string" },
        "classTeacherId": { "type": "string" },
        "subjectAssignments": { "type": "array" },
        "updatedByUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["schoolId", "className", "section", "classTeacherId", "subjectAssignments", "updatedByUid", "createdAt", "updatedAt"]
    },
    "SubjectRule": {
      "title": "SubjectRule",
      "description": "Optional timetable scheduling preferences per subject in a school (preferred time of day, double period, max once per day).",
      "type": "object",
      "properties": {
        "schoolId": { "type": "string" },
        "subjectName": { "type": "string" },
        "preferredTimeOfDay": { "type": "string", "enum": ["NO_PREFERENCE", "MORNING", "AFTERNOON"] },
        "allowDoublePeriod": { "type": "boolean" },
        "maxOncePerDay": { "type": "boolean" },
        "updatedByUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["schoolId", "subjectName", "preferredTimeOfDay", "allowDoublePeriod", "maxOncePerDay", "updatedByUid", "createdAt", "updatedAt"]
    },
    "TimetableCell": {
      "title": "TimetableCell",
      "description": "Single scheduled timetable cell with deterministic ID (school + session + class + section + day + slot) controlled by the Timetable module.",
      "type": "object",
      "properties": {
        "schoolId": { "type": "string" },
        "session": { "type": "string" },
        "className": { "type": "string" },
        "section": { "type": "string" },
        "day": { "type": "string", "enum": ["MON", "TUE", "WED", "THU", "FRI", "SAT", "SUN"] },
        "slotId": { "type": "string" },
        "subjectName": { "type": "string" },
        "teacherId": { "type": "string" },
        "teacherName": { "type": "string" },
        "locked": { "type": "boolean" },
        "updatedByUid": { "type": "string" },
        "updatedByName": { "type": "string" },
        "clientEditedAtMs": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["schoolId", "session", "className", "section", "day", "slotId", "subjectName", "teacherId", "teacherName", "locked", "updatedByUid", "updatedByName", "clientEditedAtMs", "createdAt", "updatedAt"]
    },
    "TeacherLeave": {
      "title": "TeacherLeave",
      "description": "Teacher leave record covering a single date or date range (optional half-day slots), with request/approval workflow.",
      "type": "object",
      "properties": {
        "teacherId": { "type": "string" },
        "teacherName": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "reasonType": { "type": "string", "enum": ["CASUAL_LEAVE", "SICK", "DUTY", "OTHER"] },
        "reasonNote": { "type": "string" },
        "halfDay": { "type": "boolean" },
        "halfDaySlotIds": { "type": "array" },
        "status": { "type": "string", "enum": ["PENDING", "APPROVED", "REJECTED", "CANCELLED"] },
        "requestedByUid": { "type": "string" },
        "requestedByName": { "type": "string" },
        "approvedByUid": { "type": "string" },
        "approvedByName": { "type": "string" },
        "approvedAtMs": { "type": "integer" },
        "updatedByUid": { "type": "string" },
        "updatedByName": { "type": "string" },
        "clientEditedAtMs": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["teacherId", "teacherName", "startDate", "endDate", "reasonType", "reasonNote", "halfDay", "halfDaySlotIds", "status", "requestedByUid", "requestedByName", "approvedByUid", "approvedByName", "approvedAtMs", "updatedByUid", "updatedByName", "clientEditedAtMs", "createdAt", "updatedAt"]
    },
    "Substitution": {
      "title": "Substitution",
      "description": "Date-scoped substitution assignment keyed deterministically by date, school, class, section, and slot; never alters weekly timetable.",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "day": { "type": "string", "enum": ["MON", "TUE", "WED", "THU", "FRI", "SAT", "SUN"] },
        "schoolId": { "type": "string" },
        "session": { "type": "string" },
        "className": { "type": "string" },
        "section": { "type": "string" },
        "slotId": { "type": "string" },
        "slotLabel": { "type": "string" },
        "startMinutes": { "type": "integer" },
        "endMinutes": { "type": "integer" },
        "subjectName": { "type": "string" },
        "absentTeacherId": { "type": "string" },
        "absentTeacherName": { "type": "string" },
        "leaveId": { "type": "string" },
        "substituteTeacherId": { "type": "string" },
        "substituteTeacherName": { "type": "string" },
        "overrideUsed": { "type": "boolean" },
        "overrideReason": { "type": "string" },
        "updatedByUid": { "type": "string" },
        "updatedByName": { "type": "string" },
        "clientEditedAtMs": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["date", "day", "schoolId", "session", "className", "section", "slotId", "slotLabel", "startMinutes", "endMinutes", "subjectName", "absentTeacherId", "absentTeacherName", "leaveId", "substituteTeacherId", "substituteTeacherName", "overrideUsed", "overrideReason", "updatedByUid", "updatedByName", "clientEditedAtMs", "createdAt", "updatedAt"]
    },
    "TimetableUndoSnapshot": {
      "title": "TimetableUndoSnapshot",
      "description": "Latest pre-auto-generate snapshot per school and session allowing one-tap Undo auto-generate.",
      "type": "object",
      "properties": {
        "schoolId": { "type": "string" },
        "session": { "type": "string" },
        "scopeLabel": { "type": "string" },
        "classNameFilter": { "type": "string" },
        "sectionFilter": { "type": "string" },
        "seedUsed": { "type": "integer" },
        "previousCells": { "type": "array" },
        "affectedCellIds": { "type": "array" },
        "createdByUid": { "type": "string" },
        "createdByName": { "type": "string" },
        "createdAtMs": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["schoolId", "session", "scopeLabel", "classNameFilter", "sectionFilter", "seedUsed", "previousCells", "affectedCellIds", "createdByUid", "createdByName", "createdAtMs", "createdAt", "updatedAt"]
    },
    "TeacherAccessScope": {
      "title": "TeacherAccessScope",
      "description": "Server-verified mirror of a linked teacher member's Phase 4 class-section-subject assignments and class teacher sections enforced in Firestore security rules.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "teacherId": { "type": "string" },
        "teacherName": { "type": "string" },
        "assignedClassSectionSubjects": { "type": "array" },
        "classTeacherSections": { "type": "array" },
        "updatedByUid": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "teacherId", "teacherName", "assignedClassSectionSubjects", "classTeacherSections", "updatedByUid", "updatedAt"]
    },
    "TeacherAttendance": {
      "title": "TeacherAttendance",
      "description": "Daily per-school teacher attendance entry (Present, Absent, On Leave, Half-Day) controlled by Timetable module access.",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "schoolId": { "type": "string" },
        "teacherId": { "type": "string" },
        "teacherName": { "type": "string" },
        "status": { "type": "string", "enum": ["PRESENT", "ABSENT", "ON_LEAVE", "HALF_DAY"] },
        "note": { "type": "string" },
        "linkedLeaveId": { "type": "string" },
        "updatedByUid": { "type": "string" },
        "updatedByName": { "type": "string" },
        "clientEditedAtMs": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["date", "schoolId", "teacherId", "teacherName", "status", "note", "linkedLeaveId", "updatedByUid", "updatedByName", "clientEditedAtMs", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Private user account and membership index."
    },
    "/orgCodes/{code}": {
      "schema": { "$ref": "#/entities/OrgCodeReservation" },
      "description": "Exact-code public lookup returning only orgId and organisation name."
    },
    "/organisations/{orgId}": {
      "schema": { "$ref": "#/entities/Organisation" },
      "description": "Multi-tenant organisation root document."
    },
    "/organisations/{orgId}/members/{memberUid}": {
      "schema": { "$ref": "#/entities/OrgMember" },
      "description": "Organisation member access control record."
    },
    "/organisations/{orgId}/joinRequests/{reqUid}": {
      "schema": { "$ref": "#/entities/JoinRequest" },
      "description": "Pending membership requests awaiting admin approval."
    },
    "/organisations/{orgId}/inviteCodes/{inviteCode}": {
      "schema": { "$ref": "#/entities/InviteCode" },
      "description": "One-time expiring invite codes with preset roles."
    },
    "/organisations/{orgId}/schools/{schoolId}": {
      "schema": { "$ref": "#/entities/School" },
      "description": "Schools belonging to an organisation."
    },
    "/organisations/{orgId}/schools/{schoolId}/students/{studentId}": {
      "schema": { "$ref": "#/entities/Student" },
      "description": "Students enrolled in a school."
    },
    "/organisations/{orgId}/schools/{schoolId}/marks/{markId}": {
      "schema": { "$ref": "#/entities/Mark" },
      "description": "Subject exam component marks."
    },
