    function isValidAdmissionEnquiry(data) {
      return data.keys().hasAll([
          'schoolId', 'session', 'childName', 'classWanted', 'guardianName', 'mobile', 'source', 'notes',
          'enquiryDateIso', 'nextFollowUpDateIso', 'status', 'lostReason',
